---
import WhatsAppChat from '../components/WhatsAppChat.astro';
import Cookie from '../components/Cookie.astro';
import { OFFERTA, visibileAlBuild } from '../data/offerta.js';
const ofVis = visibileAlBuild();
import '@fontsource-variable/archivo';
import font from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import { SITO, GOOGLE } from '../data/sito.js';
import { urlCategoria, ORDINE_CAT } from '../data/catalogo';
interface Props { title: string; description?: string; image?: string; noindex?: boolean; jsonld?: object; ogType?: string; prezzo?: number }
const { prezzo, ogType = 'website', title, description: descrizione = 'Vendita e centro assistenza autorizzato a Casavatore (Napoli). Utensili, batterie, kit e riparazioni con ricambi originali.', image, noindex, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITO.url).href;
const ogImg = new URL(image || '/og/semi.jpg', SITO.url).href;
const robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// Ogni anteprima di link (WhatsApp, Facebook, Google) comincia con "Concessionario DEWALT Lazio, Campania, Molise"
const fullTitle = title === SITO.nome ? `${SITO.concessionario} · ${SITO.nome}` : `${title} · ${SITO.nome}`;
const description = descrizione.startsWith('Concessionario') ? descrizione : `${SITO.concessionario}. ${descrizione}`;
const sito = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITO.url + '/#sito', name: SITO.nome, alternateName: 'semistore.it', inLanguage: 'it-IT', publisher: { '@id': SITO.url + '/#negozio' }, url: SITO.url + '/', potentialAction: { '@type': 'SearchAction', target: `${SITO.url}/catalogo/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } };
const ZONE = ['Casavatore', 'Napoli', 'Casoria', 'Arzano', 'Afragola', 'Frattamaggiore', 'Caivano', 'Secondigliano', 'Melito di Napoli', 'Sant\'Antimo', 'Grumo Nevano', 'Cardito', 'Acerra', 'Pomigliano d\'Arco'];
const org = {
  '@context': 'https://schema.org', '@type': 'HardwareStore', '@id': SITO.url + '/#negozio',
  name: SITO.nome, alternateName: ['SE.M.I. srl Professional', 'Semi Srl', 'Se.Mi. srl'], legalName: 'SE.M.I. S.R.L.',
  description: 'Concessionario DEWALT, STANLEY e BLACK+DECKER per Lazio, Campania e Molise, con vendita e centro assistenza autorizzato a Casavatore (Napoli): utensili DEWALT, STANLEY, BLACK+DECKER, USAG e LENOX, riparazioni in garanzia e fuori garanzia con ricambi originali.',
  url: SITO.url + '/', logo: SITO.url + '/icon-512.png', image: [SITO.url + '/og-semi.png'],
  telephone: SITO.telefonoLink, email: SITO.email, vatID: 'IT' + SITO.piva, taxID: SITO.piva, foundingDate: '1997',
  priceRange: '€€', currenciesAccepted: 'EUR', paymentAccepted: 'Contanti, carta di credito, bancomat, bonifico',
  address: { '@type': 'PostalAddress', streetAddress: 'Viale Guglielmo Marconi 225', postalCode: SITO.cap, addressLocality: SITO.citta, addressRegion: SITO.provincia, addressCountry: 'IT' },
  geo: { '@type': 'GeoCoordinates', latitude: 40.8934602, longitude: 14.2784996 },
  areaServed: [...['Lazio', 'Campania', 'Molise'].map((n) => ({ '@type': 'AdministrativeArea', name: n })), ...ZONE.map((n) => ({ '@type': 'City', name: n })), { '@type': 'Country', name: 'Italia' }],
  brand: ['DEWALT', 'STANLEY', 'BLACK+DECKER', 'USAG', 'LENOX'].map((n) => ({ '@type': 'Brand', name: n })),
  knowsAbout: ['Elettroutensili DEWALT', 'Riparazione elettroutensili', 'Centro assistenza DEWALT', 'Ricambi originali DEWALT', 'Batterie DEWALT XR e FLEXVOLT', 'Garanzia DEWALT'],
  sameAs: [SITO.instagram, SITO.facebook, SITO.tiktok, GOOGLE.scheda, 'https://maps.google.com/?cid=9040461481195761840'].filter(Boolean),
  hasMap: 'https://maps.google.com/?cid=9040461481195761840',
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', telephone: SITO.telefonoLink, email: SITO.email, areaServed: 'IT', availableLanguage: 'Italian' }],
  makesOffer: [{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Riparazione elettroutensili DEWALT, STANLEY e BLACK+DECKER', description: 'Centro assistenza autorizzato: riparazioni in garanzia e fuori garanzia, preventivo prima dell\'intervento, ricambi originali.', url: SITO.url + '/assistenza/', areaServed: { '@type': 'City', name: 'Napoli' } } }],
  openingHoursSpecification: Object.entries(SITO.fasce).flatMap(([g, f]) => f.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][Number(g)], opens, closes }))),
};
const path = Astro.url.pathname;
const nav = [
  ['/catalogo/', 'Prodotti'], [urlCategoria('Trapani e avvitatori'), 'Trapani'], [urlCategoria('Batterie e caricabatterie'), 'Batterie'], [urlCategoria('Kit'), 'Kit'],
  ['/assistenza/', 'Assistenza'], ['/contatti/', 'Contatti'],
];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="google-site-verification" content="uFX-a2__vUSyvejgzoFomgdZysoH-WRSu3t4_mjmu3A" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#15171a" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITO.nome} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:secure_url" content={ogImg} />
  {/\.jpe?g$/.test(ogImg) && <meta property="og:image:type" content="image/jpeg" />}
  {ogImg.includes('/og/') && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
  <meta property="og:image:alt" content={title} />
  {prezzo && <><meta property="product:price:amount" content={(prezzo / 100).toFixed(2)} /><meta property="product:price:currency" content="EUR" /></>}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />
  {robots && !noindex && <meta name="robots" content={robots} />}
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(sito)} />}
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <!-- Foto rotte (link esterni morti): niente testo alternativo sotto i bollini, si mostra il codice prodotto o si nasconde l'immagine -->
  <script is:inline>addEventListener('error',function(e){var i=e.target;if(!i||i.tagName!=='IMG'||i.dataset.ko)return;i.dataset.ko='1';var t=i.getAttribute('data-ph');if(t){var s=document.createElement('span');s.className='img-ph mono';s.textContent=t;i.replaceWith(s)}else{i.style.visibility='hidden'}},true)</script>
</head>
<body>
  <a class="skip" href="#main">Vai al contenuto</a>
  {OFFERTA.attiva && (
    <a class="of-bar" href={OFFERTA.url} target="_blank" rel="noopener" data-offerta data-scade={OFFERTA.scade} data-inizio={OFFERTA.inizio} hidden={!ofVis}>
      <span class="wrap"><b>⚡ Offerte Flash {OFFERTA.sconto ? `fino al ${OFFERTA.sconto}` : ''}</b> <span class="of-bar-s" data-of-bar-s>prezzi speciali a tempo limitato</span> <span class="of-bar-cd mono" data-of-cd hidden={!ofVis}>{ofVis ? <>Termina tra <b>…</b></> : null}</span> <u>Scopri →</u></span>
    </a>
  )}
  <div class="strip"><div class="wrap row between">
    <span><b>{SITO.concessionario}</b> · Vendita e Assistenza Autorizzata</span>
    <span class="row gap"><span>Spedizione in {SITO.spedizione.giorni} giorni lavorativi</span><a href={`tel:${SITO.telefonoLink}`}>Tel. {SITO.telefono}</a>
      <span class="soc" aria-label="Seguici">
        {SITO.facebook && <a href={SITO.facebook} target="_blank" rel="noopener" aria-label="Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.6 21.5v-8.2h2.8l.4-3.3h-3.2V8c0-.9.3-1.6 1.6-1.6H17V3.5a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3.3h2.8v8.2z"/></svg></a>}
        {SITO.instagram && <a href={SITO.instagram} target="_blank" rel="noopener" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2.1"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.9"/></g><circle cx="17.2" cy="6.8" r="1.25" fill="currentColor"/></svg></a>}
        {SITO.tiktok && <a href={SITO.tiktok} target="_blank" rel="noopener" aria-label="TikTok" title="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.7 5.6a4.4 4.4 0 0 1-1.1-2.9h-3.2v12.6a2.7 2.7 0 1 1-2.7-2.7c.3 0 .6 0 .8.1V9.5a6 6 0 1 0 5.1 5.9V9a7.5 7.5 0 0 0 4.4 1.4V7.2a4.4 4.4 0 0 1-3.3-1.6z"/></svg></a>}
        <a href={GOOGLE.scheda} target="_blank" rel="noopener" aria-label="Google: recensioni e mappa" title="Google"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 10.2H12v3.9h5.5c-.6 2.6-2.8 4-5.5 4a6.1 6.1 0 1 1 4-10.7l2.8-2.8A10 10 0 1 0 22 12c0-.6-.1-1.2-.4-1.8z"/></svg></a>
        {SITO.whatsapp && <a href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp" data-apri-wa><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.93 9.93 0 0 0-8.5 15.05L2 22l5.08-1.5A9.94 9.94 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.02.9.9-2.94-.2-.31a8.17 8.17 0 1 1 6.82 3.68zm4.5-6.1c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.96-.14.17-.29.19-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.3 2.76 2.76 0 0 0-.86 2.05 4.8 4.8 0 0 0 1 2.54 10.96 10.96 0 0 0 4.2 3.71c1.56.68 2.18.73 2.96.61.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg></a>}
      </span>
    </span>
  </div></div>
  <header class="hdr" id="hdr">
    <div class="wrap row hdr-in">
      <button type="button" class="hb" id="hb" aria-label="Apri il menu" aria-controls="menu" aria-expanded="false"><span></span><span></span><span></span></button>
      <a href="/" class="logo" aria-label="Semi Store, home"><img src="/logo.svg" alt="Semi Store · Assistenza" width="374" height="120" /></a>
      <nav aria-label="Principale" class="nav">
        {nav.map(([h, l]) => <a href={h} aria-current={path === h ? 'page' : undefined}>{l}</a>)}
      </nav>
      <div class="hdr-act">
        <form action="/catalogo/" method="get" role="search" class="search">
          <label for="q" class="sr">Cerca</label>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9a9ca1" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <input id="q" name="q" type="search" enterkeyhint="search" placeholder="Cerca modello, es. DCD805" autocomplete="off" />
        </form>
        <a href="/account/" class="btn-acc" aria-label="Il mio account" title="Il mio account"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></a>
        <a href="/carrello/" class="btn-cart"><span class="sr">Carrello, articoli: </span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg>
          <span data-cart-count>0</span>
        </a>
      </div>
    </div>
  </header>
  <div class="hdr-sub">
    <div class="wrap">
      <form action="/catalogo/" method="get" role="search" class="search">
        <label for="q2" class="sr">Cerca</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9a9ca1" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <input id="q2" name="q" type="search" placeholder="Cerca modello, es. DCD805" autocomplete="off" enterkeyhint="search" />
      </form>
    </div>
  </div>
  <dialog class="mn" id="menu" aria-label="Menu">
    <div class="mn-h">
      <img src="/logo.svg" alt="Semi Store" width="374" height="120" />
      <button type="button" class="mn-x" id="mn-x" aria-label="Chiudi il menu" autofocus>✕</button>
    </div>
    <nav class="mn-b" aria-label="Menu">
      <a href="/" class="mn-l">Home</a>
      <a href="/catalogo/" class="mn-l">Tutti i prodotti</a>
      <details open>
        <summary class="mn-l">Categorie</summary>
        <div class="mn-c">{ORDINE_CAT.map((c) => <a href={urlCategoria(c)}>{c}</a>)}</div>
      </details>
      <details>
        <summary class="mn-l">Marchi</summary>
        <div class="mn-c">{[['DEWALT', 'dewalt'], ['STANLEY', 'stanley'], ['BLACK+DECKER', 'blackdecker'], ['USAG', 'usag'], ['LENOX', 'lenox']].map(([n, q]) => <a href={`/catalogo/?marca=${q}`}>{n}</a>)}</div>
      </details>
      <a href="/catalogo/?volt=18v" class="mn-l">Sistema 18V XR</a>
      <a href="/catalogo/?volt=54v" class="mn-l">FLEXVOLT 54V</a>
      <a href="/assistenza/" class="mn-l mn-y">Richiedi una riparazione</a>
      <a href="/assistenza/#stato" class="mn-l">Stato della riparazione</a>
      <a href="/chi-siamo/" class="mn-l">Chi siamo</a>
      <a href="/contatti/" class="mn-l">Contatti e orari</a>
    </nav>
    <div class="mn-f">
      <a href={`tel:${SITO.telefonoLink}`} class="btn btn-y">Chiama {SITO.telefono}</a>
      {SITO.whatsapp && <a href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener" class="btn btn-wa"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.93 9.93 0 0 0-8.5 15.05L2 22l5.08-1.5A9.94 9.94 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.02.9.9-2.94-.2-.31a8.17 8.17 0 1 1 6.82 3.68zm4.5-6.1c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.96-.14.17-.29.19-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.3 2.76 2.76 0 0 0-.86 2.05 4.8 4.8 0 0 0 1 2.54 10.96 10.96 0 0 0 4.2 3.71c1.56.68 2.18.73 2.96.61.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg> Scrivici su WhatsApp</a>}
      <a href={GOOGLE.indicazioni} target="_blank" rel="noopener" class="btn btn-o">Indicazioni per il negozio</a>
      <span>{SITO.indirizzo}, {SITO.citta} ({SITO.provincia})</span>
    </div>
  </dialog>

  <main id="main"><slot /></main>

  <footer class="ftr" id="contatti">
    <div class="wrap grid4">
      <div class="col">
        <img class="ftr-logo" src="/logo.svg" alt="Semi Store" width="374" height="120" loading="lazy" />
        <span>{SITO.denominazione}<br />{SITO.indirizzo}<br />{SITO.cap} {SITO.citta} ({SITO.provincia})</span>
        <span><a href={`tel:${SITO.telefonoLink}`}>Tel. {SITO.telefono}</a><br />{SITO.whatsapp && <><a href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITO.whatsapp.slice(2).replace(/(\d{3})(\d{3})(\d+)/, '$1 $2 $3')}</a><br /></>}<a href={`mailto:${SITO.email}`}>{SITO.email}</a></span>
      </div>
      <div class="col"><b>Categorie</b>{['Trapani e avvitatori', 'Tassellatori e demolitori', 'Smerigliatrici e levigatrici', 'Seghe e troncatrici', 'Batterie e caricabatterie', 'Misura e laser'].map((c) => <a href={urlCategoria(c)}>{c}</a>)}</div>
      <div class="col"><b>Negozio</b><a href="/catalogo/">Catalogo</a><a href="/condizioni-di-vendita/">Spedizioni e resi</a><a href="/condizioni-di-vendita/#pagamenti">Pagamenti</a><a href="/punti/">Programma punti</a><a href="/account/">Il mio account</a></div>
      <div class="col"><b>Assistenza</b><a href="/assistenza/">Richiedi riparazione</a><a href="/assistenza/#stato">Stato riparazione</a><a href="/assistenza/#preventivo">Preventivo</a></div>
      <div class="col"><b>Seguici</b>
        {SITO.instagram && <a href={SITO.instagram} rel="noopener">Instagram</a>}
        {SITO.facebook && <a href={SITO.facebook} rel="noopener">Facebook</a>}
        {SITO.tiktok && <a href={SITO.tiktok} rel="noopener">TikTok</a>}
        <a href={GOOGLE.scheda} rel="noopener">Google Maps</a>
        {SITO.orari.length > 0 && <><b style="margin-top:12px">Orari</b>{SITO.orari.map((o) => <span>{o.giorni} {o.ore}</span>)}</>}
      </div>
    </div>
    <div class="wrap legal">
      <span>© {new Date().getFullYear()} {SITO.denominazione} · Sede legale {SITO.sedeLegale} · Sede operativa {SITO.indirizzo}, {SITO.cap} {SITO.citta} ({SITO.provincia}) · P.IVA e C.F. {SITO.piva} · REA {SITO.rea}{SITO.capitaleSociale && <> · Cap. soc. {SITO.capitaleSociale}</>} · PEC <a href={`mailto:${SITO.pec}`}>{SITO.pec}</a></span>
      <span>DEWALT, BLACK+DECKER e STANLEY sono marchi registrati dei rispettivi proprietari.</span>
      <span><a href="/recesso/" class="rec-l">Recedere dal contratto qui</a> · <a href="/privacy/">Privacy</a> · <a href="/privacy/#cookie">Cookie</a>{(SITO.ga4 || SITO.pixelMeta) && <> · <a href="#" data-preferenze-cookie>Preferenze cookie</a></>} · <a href="/condizioni-di-vendita/">Condizioni di vendita</a></span>
    </div>
  </footer>
  <WhatsAppChat />
  <Cookie />
  <script>
    import { count } from '../scripts/cart.js';
    const upd = () => document.querySelectorAll('[data-cart-count]').forEach((e) => (e.textContent = String(count())));
    upd(); addEventListener('cart:change', upd); addEventListener('storage', upd);
  </script>
  <script>import '../scripts/offerta.js';</script>
  <script>import '../scripts/suggerimenti.js';</script>
  <script>
    // menu a tendina (telefono)
    const m = document.getElementById('menu') as HTMLDialogElement, hb = document.getElementById('hb')!;
    const chiudi = () => { m.classList.remove('on'); hb.setAttribute('aria-expanded', 'false'); setTimeout(() => m.close(), 220); };
    hb.addEventListener('click', () => { m.showModal(); requestAnimationFrame(() => m.classList.add('on')); hb.setAttribute('aria-expanded', 'true'); });
    document.getElementById('mn-x')!.addEventListener('click', chiudi);
    m.addEventListener('click', (e) => { if (e.target === m) chiudi(); });
    m.addEventListener('cancel', (e) => { e.preventDefault(); chiudi(); });
  </script>
  <script is:inline>
    // presenze per l'app interna: id casuale del browser, nessun cookie, nessun IP salvato
    (function(){try{var k='semi-vid',v=localStorage.getItem(k);if(!v){v=Math.random().toString(36).slice(2)+Date.now().toString(36);localStorage.setItem(k,v)}
    var n=1,p=location.pathname,b=function(){if(document.visibilityState!=='visible')return;fetch('/api/presenza',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({v:v,p:p,n:n}),keepalive:true}).catch(function(){});n=0};
    b();setInterval(b,30000);document.addEventListener('visibilitychange',b)}catch(e){}})();
  </script>
</body>
</html>

<style is:global>
