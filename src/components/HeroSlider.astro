---
// Banner a scorrimento in cima alla home: foto vere del negozio e del laboratorio (dal video) + una slide prodotti.
// Scorre da solo ogni 6 secondi, si ferma appena l'utente lo tocca. Per cambiare testi o foto basta modificare "slide".
import prodotti from '../data/prodotti.json';
import { fotoDi } from '../data/foto';
import { euro } from '../data/sito.js';

const tot = prodotti.length;
const n18 = prodotti.filter((p) => p.volt === '18V').length;
const pick = (m: string) => prodotti.find((p) => p.modello === m);
const collage = ['DCD805P2T', 'DCG405P2', 'DCF850P2T'].map(pick).filter((p) => p && fotoDi(p.slug)) as any[];
const daPrezzo = Math.min(...collage.map((p) => p.prezzo));

const slide = [
  { img: '/img/hero/negozio.webp', pos: '30% 50%', k: 'Negozio DEWALT · Casavatore', h: `Oltre ${String(tot).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} utensili professionali`, p: 'DEWALT, STANLEY e BLACK+DECKER sotto il prezzo di listino. Spedizione in tutta Italia o ritiro in negozio.', cta: ['Scopri il catalogo', '/catalogo/'], cta2: ['Vieni a trovarci', '/contatti/'] },
  { img: '/img/hero/officina.webp', pos: '78% 40%', k: 'Centro assistenza autorizzato', h: 'Ripariamo noi, con ricambi originali', p: 'Laboratorio interno, garanzie DEWALT gestite in sede e preventivo prima di ogni intervento.', cta: ['Richiedi una riparazione', '/assistenza/'], cta2: ['Segui la riparazione', '/assistenza/#stato'] },
  { collage: true, k: 'I più richiesti', h: 'Il cantiere parte da qui', p: `Trapano, avvitatore a impulsi e smerigliatrice 18V XR con batterie 5 Ah. Da ${euro(daPrezzo)}.`, cta: ['Vedi i prodotti', '/catalogo/?volt=18v'] },
  { img: '/img/hero/xr18v.webp', pos: '65% 50%', k: 'Sistema XR 18V', h: 'Una batteria, tutti gli utensili', p: `${n18} utensili e accessori 18V XR compatibili: compri la batteria una volta e la usi su tutto.`, cta: ['Scegli il tuo 18V', '/catalogo/?volt=18v'] },
];
---
<section class="hs" aria-roledescription="carosello" aria-label="In primo piano">
  <div class="hs-t" id="hs" tabindex="0">
    {slide.map((s, i) => (
      <div class={`hs-s ${s.collage ? 'hs-c' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} di ${slide.length}`}>
        {s.img && <img class="hs-bg" src={s.img} alt="" width="1280" height="528" style={`object-position:${s.pos}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />}
        {s.collage && (
          <span class="hs-col" aria-hidden="true">
            {collage.map((p, k) => <img src={fotoDi(p.slug)} alt="" width="800" height="800" loading="lazy" decoding="async" class={`hs-p hs-p${k}`} />)}
          </span>
        )}
        <div class="wrap hs-in">
          <div class="hs-txt">
            <span class="hs-k">{s.k}</span>
            {i === 0 ? <h1>{s.h}</h1> : <h2>{s.h}</h2>}
            <p>{s.p}</p>
            <div class="hs-b">
              <a class="btn btn-y" href={s.cta[1]}>{s.cta[0]}</a>
              {s.cta2 && <a class="btn hs-o" href={s.cta2[1]}>{s.cta2[0]}</a>}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  <button type="button" class="hs-a hs-prev" data-d="-1" aria-label="Slide precedente">‹</button>
  <button type="button" class="hs-a hs-next" data-d="1" aria-label="Slide successiva">›</button>
  <div class="hs-dots" aria-hidden="true">{slide.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</div>
</section>

<style>
  .hs{position:relative;background:var(--ink);color:#fff}
  .hs-t{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain}
  .hs-t::-webkit-scrollbar{display:none}
  .hs-s{position:relative;flex:0 0 100%;scroll-snap-align:start;min-height:clamp(440px,42vw,560px);display:flex;align-items:center;overflow:hidden;isolation:isolate}
  .hs-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
  .hs-s:not(.hs-c)::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#15171af2 0%,#15171acc 38%,#15171a33 70%,#15171a00 100%)}
  .hs-in{width:100%}
  .hs-txt{max-width:560px;display:flex;flex-direction:column;gap:16px;padding:48px 0 64px}
  .hs-k{align-self:flex-start;background:var(--y);color:var(--ink);font-weight:800;font-size:13px;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:4px}
  .hs h1,.hs h2{font-size:clamp(34px,4.6vw,60px);line-height:.98;text-transform:uppercase;font-weight:900}
  .hs p{margin:0;font-size:18px;color:#e2e3e5;max-width:480px}
  .hs-b{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
  .hs-o{border:1px solid #ffffff66;color:#fff;background:#15171a66;backdrop-filter:blur(4px)}.hs-o:hover{color:var(--y)}
  /* slide prodotti: fondo giallo come le confezioni DEWALT */
  .hs-c{background:var(--y);color:var(--ink)}
  .hs-c::after{content:'';position:absolute;inset:0;z-index:-2;background:repeating-linear-gradient(-45deg,#0000 0 22px,#00000008 22px 44px)}
  .hs-c p{color:#2b2d31}.hs-c .hs-k{background:var(--ink);color:var(--y)}
  .hs-c .hs-o{color:var(--ink);border-color:#15171a55;background:transparent}
  .hs-col{position:absolute;right:max(20px,calc(50% - 600px));top:50%;transform:translateY(-50%);width:min(52%,620px);aspect-ratio:1.35;z-index:-1}
  .hs-p{position:absolute;background:#fff;border-radius:18px;padding:16px;box-shadow:0 24px 50px #0003;object-fit:contain}
  .hs-p0{width:52%;left:24%;top:4%;z-index:2}
  .hs-p1{width:40%;left:0;bottom:2%;transform:rotate(-5deg)}
  .hs-p2{width:40%;right:0;bottom:2%;transform:rotate(5deg)}
  .hs-a{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:0;background:#ffffffe6;color:var(--ink);font-size:28px;line-height:1;cursor:pointer;box-shadow:0 6px 18px #0003;z-index:2}
  .hs-prev{left:14px}.hs-next{right:14px}
  .hs-dots{position:absolute;left:0;right:0;bottom:18px;display:flex;justify-content:center;gap:7px;z-index:2}
  .hs-dots i{width:8px;height:8px;border-radius:4px;background:#ffffff80;box-shadow:0 0 0 1px #0002;transition:width .2s,background .2s}.hs-dots i.on{width:24px;background:var(--y)}
  @media (max-width:760px){
    /* telefono: foto in alto, testo sotto su fondo scuro sfumato */
    .hs-s{min-height:0;flex-direction:column;align-items:stretch;justify-content:flex-end;padding-top:min(56vw,300px)}
    .hs-bg{height:min(72vw,380px)}
    .hs-s:not(.hs-c)::before{background:linear-gradient(180deg,#15171a00 0,#15171a00 min(30vw,150px),#15171a min(70vw,370px))}
    .hs-txt{padding:0 0 52px;gap:12px}
    .hs h1,.hs h2{font-size:clamp(28px,8.6vw,40px)}
    .hs p{font-size:15.5px}
    .hs-b .btn{flex:1 1 auto;min-height:46px;padding:0 16px;font-size:15px}
    .hs-col{position:relative;right:auto;top:auto;transform:none;width:calc(100% - 40px);margin:-28px auto 8px;aspect-ratio:1.5}
    .hs-c{padding-top:24px}
    .hs-a{display:none}
  }
  @media (prefers-reduced-motion:reduce){.hs-t{scroll-behavior:auto}}
</style>

<script>
  const box = document.getElementById('hs');
  if (box) {
    const dots = [...document.querySelectorAll('.hs-dots i')];
    const n = box.children.length;
    const cur = () => Math.round(box.scrollLeft / box.clientWidth);
    const go = (i: number) => box.scrollTo({ left: ((i + n) % n) * box.clientWidth });
    box.addEventListener('scroll', () => { const c = cur(); dots.forEach((d, k) => d.classList.toggle('on', k === c)); }, { passive: true });
    let fermo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLButtonElement>('.hs-a').forEach((b) => b.addEventListener('click', () => { fermo = true; go(cur() + Number(b.dataset.d)); }));
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(cur() + 1); if (e.key === 'ArrowLeft') go(cur() - 1); });
    ['pointerdown', 'touchstart', 'wheel', 'focusin'].forEach((ev) => box.addEventListener(ev, () => (fermo = true), { passive: true }));
    setInterval(() => { if (!fermo && !document.hidden) go(cur() + 1); }, 6000);
  }
</script>
