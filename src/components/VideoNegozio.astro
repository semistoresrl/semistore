---
// Video del negozio: anteprima muta in loop (parte solo quando è visibile) + video completo con audio in una finestra.
import { SITO, GOOGLE } from '../data/sito.js';
import ApertoOra from './ApertoOra.astro';
const { titolo = 'Vieni a trovarci', compatto = false } = Astro.props;
const mappa = GOOGLE.indicazioni;
---
<section class={`vn ${compatto ? 'vn-c' : ''}`}>
  <div class="vn-in">
    <button type="button" class="vn-v" data-vn-open aria-label="Guarda il video del negozio, 22 secondi, con audio">
      <video class="vn-prev" src="/video/negozio-anteprima.mp4" poster="/video/negozio-poster.jpg" muted loop playsinline preload="none" aria-hidden="true"></video>
      <span class="vn-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
      <span class="vn-lab"><b>Guarda il negozio</b><span>0:22 · con audio</span></span>
    </button>
    <div class="vn-t">
      <span class="vn-k mono">Il negozio · {SITO.citta}</span>
      <h2>{titolo}</h2>
      <ApertoOra />
      <p>Esposizione completa DEWALT, BLACK+DECKER e STANLEY, laboratorio di riparazione interno e ricambi originali. Passa a provare gli utensili o portaci il tuo in assistenza.</p>
      <ul class="vn-l">
        <li><b>Indirizzo</b><span>{SITO.indirizzo}, {SITO.cap} {SITO.citta} ({SITO.provincia})</span></li>
        <li><b>Telefono</b><span>{SITO.telefono}</span></li>
        {SITO.orari.length > 0 && <li><b>Orari</b><span>{SITO.orari.map((o) => `${o.giorni} ${o.ore}`).join(' · ')}</span></li>}
      </ul>
      <div class="vn-b">
        <a class="btn btn-y" href={mappa} target="_blank" rel="noopener">Indicazioni stradali</a>
        <a class="btn btn-o" href={`tel:${SITO.telefonoLink}`}>Chiama</a>
        <a class="btn btn-o" href={GOOGLE.scheda} target="_blank" rel="noopener">Recensioni su Google</a>
      </div>
    </div>
  </div>
  <dialog class="vn-d" aria-label="Video del negozio">
    <button type="button" class="vn-x" data-vn-close aria-label="Chiudi video">✕</button>
    <video class="vn-full" src="/video/negozio.mp4" poster="/video/negozio-poster.jpg" controls playsinline preload="none"></video>
  </dialog>
</section>
<style>
  .vn{background:var(--ink);color:#fff;padding:clamp(40px,7vw,80px) 0}
  .vn-in{width:min(1200px,100% - 40px);margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(24px,4vw,56px);align-items:center}
  .vn-v{position:relative;display:block;width:100%;aspect-ratio:16/9;border:0;padding:0;border-radius:18px;overflow:hidden;cursor:pointer;background:#000;box-shadow:0 30px 60px #0008}
  .vn-v::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,#000a);pointer-events:none}
  .vn-prev{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
  .vn-v:hover .vn-prev{transform:scale(1.04)}
  .vn-play{position:absolute;left:50%;top:50%;translate:-50% -50%;width:72px;height:72px;border-radius:50%;background:var(--y);color:var(--ink);display:grid;place-items:center;z-index:1;box-shadow:0 0 0 0 #f5b80080;animation:vnpulse 2.2s infinite}
  .vn-play svg{margin-left:4px}
  @keyframes vnpulse{0%{box-shadow:0 0 0 0 #f5b80099}70%{box-shadow:0 0 0 22px #f5b80000}100%{box-shadow:0 0 0 0 #f5b80000}}
  .vn-lab{position:absolute;left:18px;bottom:16px;z-index:1;display:flex;flex-direction:column;text-align:left;color:#fff}
  .vn-lab b{font-size:18px}.vn-lab span{font-size:13px;color:#d6d7da}
  .vn-k{color:var(--y);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .vn-t{display:flex;flex-direction:column;gap:14px}
  .vn-t h2{margin:0;font-size:clamp(32px,4.5vw,52px);line-height:.95;text-transform:uppercase}
  .vn-t p{margin:0;color:#c9cbcf;font-size:16px}
  .vn-l{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
  .vn-l li{display:flex;gap:12px;border-left:3px solid var(--y);padding-left:12px;font-size:15px}.vn-l b{min-width:76px;color:#fff}.vn-l span{color:#c9cbcf}
  .vn-b{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}
  .vn-d{border:0;padding:0;background:transparent;width:min(1100px,94vw);max-width:none;overflow:visible}
  .vn-d::backdrop{background:#000d;backdrop-filter:blur(4px)}
  .vn-full{width:100%;aspect-ratio:16/9;display:block;border-radius:14px;background:#000}
  .vn-x{position:absolute;right:0;top:-48px;width:40px;height:40px;border-radius:50%;border:0;background:#fff;color:var(--ink);font-size:18px;cursor:pointer}
  @media (max-width:820px){.vn-in{grid-template-columns:1fr}.vn-play{width:60px;height:60px}}
  @media (prefers-reduced-motion:reduce){.vn-play{animation:none}.vn-prev{transition:none}}
</style>
<script>
  document.querySelectorAll('.vn').forEach((sec) => {
    const prev = sec.querySelector('.vn-prev');
    const dlg = sec.querySelector('dialog');
    const full = sec.querySelector('.vn-full');
    // l'anteprima parte solo quando è sullo schermo (e non con "riduci animazioni")
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prev && !ridotto && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { e.isIntersecting ? prev.play().catch(() => {}) : prev.pause(); }, { threshold: 0.35 }).observe(prev);
    }
    sec.querySelector('[data-vn-open]')?.addEventListener('click', () => {
      dlg.showModal(); full.currentTime = 0; full.play().catch(() => {});
    });
    const chiudi = () => { full.pause(); dlg.close(); };
    sec.querySelector('[data-vn-close]')?.addEventListener('click', chiudi);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) chiudi(); });
    dlg.addEventListener('close', () => full.pause());
    full.addEventListener('ended', chiudi);
  });
</script>
