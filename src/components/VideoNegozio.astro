---
// Video del negozio: anteprima muta in loop (parte solo quando è visibile) + video completo con audio in una finestra.
import { SITO, GOOGLE } from '../data/sito.js';
import ApertoOra from './ApertoOra.astro';
const { titolo = 'Vieni a trovarci', compatto = false } = Astro.props;
const mappa = GOOGLE.indicazioni;
---
<section class={`vn ${compatto ? 'vn-c' : ''}`}>
  <div class="vn-in">
    <button type="button" class="vn-v" data-vn-open>
      <video class="vn-prev" src="/video/negozio-anteprima.mp4" poster="/video/negozio-poster.jpg" muted autoplay loop playsinline preload="metadata" disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
      <span class="vn-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
      <span class="vn-lab"><b>Guarda il negozio</b><span>0:22 · con audio</span></span>
    </button>
    <div class="vn-t">
      <span class="vn-k mono">Il negozio · {SITO.citta}</span>
      <h2>{titolo}</h2>
      <ApertoOra />
      <p>Esposizione completa DEWALT, BLACK+DECKER e STANLEY, laboratorio di riparazione interno e ricambi originali. Passa a provare gli utensili o portaci il tuo in assistenza.</p>
      <div class="vn-info">
        <div class="vn-r"><span class="vn-i"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.6" fill="currentColor"/></svg></span><span><small>Indirizzo</small>{SITO.indirizzo}, {SITO.citta} ({SITO.provincia})</span></div>
        <a class="vn-r" href={`tel:${SITO.telefonoLink}`}><span class="vn-i"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span><span><small>Telefono</small>{SITO.telefono}</span></a>
        {SITO.orari.length > 0 && (
          <div class="vn-r"><span class="vn-i"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span><span><small>Orari</small>{SITO.orari.map((o) => <span class="vn-o"><b>{o.giorni}</b>{o.ore}</span>)}</span></div>
        )}
      </div>
      <div class="vn-b">
        <a class="vn-a vn-a-y" href={mappa} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8-8-2z" fill="currentColor"/></svg><span>Indicazioni</span></a>
        <a class="vn-a" href={`tel:${SITO.telefonoLink}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg><span>Chiama</span></a>
        <a class="vn-a" href={GOOGLE.scheda} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" fill="currentColor"/></svg><span>Recensioni</span></a>
      </div>
    </div>
  </div>
  <dialog class="vn-d" aria-label="Video del negozio">
    <button type="button" class="vn-x" data-vn-close aria-label="Chiudi video">✕</button>
    <video class="vn-full" src="/video/negozio.mp4" poster="/video/negozio-poster.jpg" controls playsinline preload="none"></video>
  </dialog>
</section>
<style>
  .vn{background:var(--ink);color:#fff;padding:clamp(40px,7vw,80px) 0}
  .vn-in{width:min(1200px,100% - 40px);margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(24px,4vw,56px);align-items:center}
  .vn-v{position:relative;display:block;width:100%;aspect-ratio:16/9;border:0;padding:0;border-radius:18px;overflow:hidden;cursor:pointer;background:#000;box-shadow:0 30px 60px #0008}
  .vn-v::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,#000a);pointer-events:none}
  .vn-prev{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
  .vn-v:hover .vn-prev{transform:scale(1.04)}
  .vn-play{position:absolute;left:50%;top:50%;translate:-50% -50%;width:72px;height:72px;border-radius:50%;background:var(--y);color:var(--ink);display:grid;place-items:center;z-index:1;box-shadow:0 0 0 0 #f5b80080;animation:vnpulse 2.2s infinite}
  .vn-play svg{margin-left:4px}
  @keyframes vnpulse{0%{box-shadow:0 0 0 0 #f5b80099}70%{box-shadow:0 0 0 22px #f5b80000}100%{box-shadow:0 0 0 0 #f5b80000}}
  .vn-lab{position:absolute;left:18px;bottom:16px;z-index:1;display:flex;flex-direction:column;text-align:left;color:#fff}
  .vn-lab b{font-size:18px}.vn-lab span{font-size:13px;color:#d6d7da}
  .vn-k{color:var(--y);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .vn-t{display:flex;flex-direction:column;gap:14px}
  .vn-t h2{margin:0;font-size:clamp(32px,4.5vw,52px);line-height:.95;text-transform:uppercase}
  .vn-t p{margin:0;color:#c9cbcf;font-size:16px}
  .vn-info{display:flex;flex-direction:column;background:#ffffff0d;border:1px solid #ffffff1a;border-radius:14px;overflow:hidden}
  .vn-r{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;color:#fff;text-decoration:none}
  .vn-r+.vn-r{border-top:1px solid #ffffff14}
  a.vn-r:hover{background:#ffffff0a;color:#fff}
  .vn-r>span:last-child{display:flex;flex-direction:column;gap:2px;font-size:16px;line-height:1.35}
  .vn-r small{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#9aa0a6}
  .vn-i{flex:none;width:38px;height:38px;border-radius:10px;background:#f5b8001f;color:var(--y);display:grid;place-items:center}
  .vn-o{display:flex;gap:10px}.vn-o b{min-width:66px;font-weight:700}
  .vn-b{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .vn-a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:76px;border-radius:12px;background:#ffffff12;border:1px solid #ffffff1f;color:#fff;font-weight:800;font-size:14px;text-decoration:none;transition:background .15s,transform .15s}
  .vn-a:hover{background:#ffffff22;color:#fff;transform:translateY(-1px)}
  .vn-a svg{color:var(--y)}
  .vn-a-y{background:var(--y);border-color:var(--y);color:var(--ink)}.vn-a-y svg{color:var(--ink)}.vn-a-y:hover{background:var(--y);color:var(--ink);filter:brightness(1.05)}
  .vn-d{border:0;padding:0;background:transparent;width:min(1100px,94vw,(100dvh - 110px) * 16 / 9);max-width:none;overflow:visible}
  .vn-d::backdrop{background:#000d;backdrop-filter:blur(4px)}
  .vn-full{width:100%;aspect-ratio:16/9;display:block;border-radius:14px;background:#000}
  .vn-x{position:absolute;right:0;top:-48px;width:40px;height:40px;border-radius:50%;border:0;background:#fff;color:var(--ink);font-size:18px;cursor:pointer}
  @media (max-width:820px){.vn-in{grid-template-columns:1fr}.vn-play{width:60px;height:60px}}
  @media (prefers-reduced-motion:reduce){.vn-play{animation:none}.vn-prev{transition:none}}
</style>
<script>
  document.querySelectorAll('.vn').forEach((sec) => {
    const prev = sec.querySelector('.vn-prev');
    const dlg = sec.querySelector('dialog');
    const full = sec.querySelector('.vn-full');
    // l'anteprima (muta, 9 secondi in loop) parte quando è sullo schermo e si ferma quando esce
    if (prev) {
      prev.muted = true; prev.defaultMuted = true; prev.playsInline = true;
      const avvia = () => { prev.preload = 'auto'; const p = prev.play(); if (p) p.catch(() => {}); };
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => { e.isIntersecting ? avvia() : prev.pause(); }, { threshold: 0.2 }).observe(prev);
      } else avvia();
      // alcuni telefoni bloccano l'avvio automatico finché l'utente non tocca la pagina
      const sblocca = () => { if (prev.paused) avvia(); };
      ['touchstart', 'scroll', 'pointerdown'].forEach((ev) => window.addEventListener(ev, sblocca, { once: true, passive: true }));
    }
    sec.querySelector('[data-vn-open]')?.addEventListener('click', () => {
      dlg.showModal(); full.currentTime = 0; full.play().catch(() => {});
    });
    const chiudi = () => { full.pause(); dlg.close(); };
    sec.querySelector('[data-vn-close]')?.addEventListener('click', chiudi);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) chiudi(); });
    dlg.addEventListener('close', () => full.pause());
    full.addEventListener('ended', chiudi);
  });
</script>
