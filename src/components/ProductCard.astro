---
import { euro } from '../data/sito.js';
import { fotoDi, fotoLocale } from '../data/foto';
import KitFoto from './KitFoto.astro';
const { p, eager = false } = Astro.props;
const img = fotoDi(p.slug, 400);
const sconto = p.prezzoListino && p.prezzoListino > p.prezzo ? Math.round((1 - p.prezzo / p.prezzoListino) * 100) : 0;
const srcset = fotoLocale(p.slug) ? `/img/prodotti/${p.slug}-400.webp 400w, /img/prodotti/${p.slug}-800.webp 800w` : undefined;
---
<a href={`/prodotti/${p.slug}/`} class="pc card" data-marca={p.marca} data-cat={p.categoria} data-volt={p.volt || ''} data-text={`${p.nome} ${p.modello} ${p.marca} ${p.categoria}`.toLowerCase()}>
  <span class="pc-img">
    {img
      ? <img src={img} srcset={srcset} sizes="(max-width:600px) 50vw, 260px" width="400" height="400" alt={p.nome} data-ph={p.modello || p.marca} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
      : p.kit ? <KitFoto pezzi={p.kit} alt={p.nome} /> : <span class="mono pc-ph">{p.modello || p.marca}</span>}
    <span class="pc-tags">{p.volt && <span class="t-k">{p.volt}</span>}<span class="t-w">{p.marca}</span></span>
  </span>
  <span class="pc-b">
    {p.modello && <span class="mono pc-code">{p.modello}</span>}
    <b class="pc-n">{p.nome}</b>
    <span class="pc-f">
      <span class="pc-prz"><span class="pc-pr">{euro(p.prezzo)}</span>{sconto >= 5 && <><span class="pc-li">Prezzo consigliato <s>{euro(p.prezzoListino)}</s></span><span class="pc-sc">-{sconto}%</span></>}</span>
      {p.disponibilita === 'conferma' ? <span class="pc-ok pc-cf">Su conferma</span> : <span class="pc-ok">Disponibile</span>}
    </span>
  </span>
</a>
<style is:global>
  .pc{display:flex;flex-direction:column;overflow:hidden;transition:transform .15s,box-shadow .15s}
  .pc[hidden]{display:none}
  .pc:hover{color:inherit;transform:translateY(-2px);box-shadow:0 14px 30px #0001}
  .pc-img{position:relative;aspect-ratio:1;background:#fff;display:grid;place-items:center;padding:44px 14px 14px;border-bottom:1px solid var(--line)}
  .pc-img img,.pc-img .kit{width:100%;height:100%;min-height:0;object-fit:contain}.pc-img{grid-template-rows:minmax(0,1fr)}
  .pc-ph{font-weight:700;font-size:24px;color:#8a867b}
  .pc-tags{position:absolute;top:12px;left:12px;right:12px;display:flex;flex-wrap:wrap;gap:6px;z-index:1;pointer-events:none}
  .t-k,.t-w{font-size:11px;font-weight:800;padding:4px 8px;border-radius:4px}.t-k{background:var(--ink);color:var(--y)}.t-w{background:#fff;border:1px solid var(--line)}
  .pc-b{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
  .pc-code{font-size:12px;color:var(--mut)}.pc-n{font-size:16px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .pc-f{display:flex;flex-direction:column;gap:4px;margin-top:auto;padding-top:8px}
  .pc-prz{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px}
  .pc-li{font-size:13px;color:var(--mut)}
  .pc-sc{font-size:12px;font-weight:900;background:var(--y);color:var(--ink);padding:3px 6px;border-radius:4px;line-height:1}
  .pc-pr{font-size:21px;font-weight:900}.pc-ok{font-size:12px;font-weight:700;color:var(--ok)}.pc-cf{color:var(--mut)}
</style>
