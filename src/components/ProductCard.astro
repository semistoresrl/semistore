---
import { euro } from '../data/sito.js';
import foto from '../data/foto.json';
const { p, eager = false } = Astro.props;
const hasImg = (foto as Record<string, boolean>)[p.slug];
---
<a href={`/prodotti/${p.slug}/`} class="pc card" data-marca={p.marca} data-cat={p.categoria} data-text={`${p.nome} ${p.modello} ${p.marca} ${p.categoria}`.toLowerCase()}>
  <span class="pc-img">
    {hasImg
      ? <img src={`/img/prodotti/${p.slug}-400.webp`} srcset={`/img/prodotti/${p.slug}-400.webp 400w, /img/prodotti/${p.slug}-800.webp 800w`} sizes="(max-width:600px) 50vw, 260px" width="400" height="400" alt={p.nome} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
      : <span class="mono pc-ph">{p.modello || p.marca}</span>}
    <span class="pc-tags">{p.volt && <span class="t-k">{p.volt}</span>}<span class="t-w">{p.marca}</span></span>
  </span>
  <span class="pc-b">
    {p.modello && <span class="mono pc-code">{p.modello}</span>}
    <b class="pc-n">{p.nome}</b>
    <span class="pc-f"><span class="pc-pr">{euro(p.prezzo)}</span><span class="pc-ok">Disponibile</span></span>
  </span>
</a>
<style>
  .pc{display:flex;flex-direction:column;overflow:hidden;transition:transform .15s,box-shadow .15s}
  .pc:hover{color:inherit;transform:translateY(-2px);box-shadow:0 14px 30px #0001}
  .pc-img{position:relative;aspect-ratio:1;background:#fff;display:grid;place-items:center;padding:14px;border-bottom:1px solid var(--line)}
  .pc-img img{width:100%;height:100%;object-fit:contain}
  .pc-ph{font-weight:700;font-size:24px;color:#c9c6bc}
  .pc-tags{position:absolute;top:12px;left:12px;display:flex;gap:6px}
  .t-k,.t-w{font-size:11px;font-weight:800;padding:4px 8px;border-radius:4px}.t-k{background:var(--ink);color:var(--y)}.t-w{background:#fff;border:1px solid var(--line)}
  .pc-b{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
  .pc-code{font-size:12px;color:var(--mut)}.pc-n{font-size:16px;line-height:1.3}
  .pc-f{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:8px}
  .pc-pr{font-size:21px;font-weight:900}.pc-ok{font-size:12px;font-weight:700;color:var(--ok)}
</style>
