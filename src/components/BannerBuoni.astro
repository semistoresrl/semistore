---
// Sezione "Buoni regalo" in home, separata dal programma punti, con lo stesso stile delle altre sezioni del sito.
import { SITO } from '../data/sito.js';
import CartaBuono from './CartaBuono.astro';
const R = SITO.buoniRegalo;
---
<section class="sec bb" aria-labelledby="bb-h">
  <div class="wrap">
    <div class="card bb-in">
      <div class="bb-tx">
        <p class="kicker bb-k">Buoni regalo</p>
        <h2 id="bb-h" class="h2 bb-h">Non sai quale utensile scegliere? Regala un buono</h2>
        <p class="bb-d">Senza scadenza, su tutto semistore.it, anche in più volte. Arriva subito per email con un codice segreto, a te o direttamente a chi lo riceve.</p>
        <div class="bb-tagli" role="list">
          {R.tagli.map((t) => <a role="listitem" href={`/buono-regalo/?importo=${t}`} class="bb-t">{t} €</a>)}
          <a role="listitem" href="/buono-regalo/" class="bb-t bb-alt">Altro importo</a>
        </div>
        <a href="/buono-regalo/" class="btn btn-y bb-go">Crea il tuo buono</a>
      </div>
      <a href="/buono-regalo/" class="bb-stack" aria-label="Crea il tuo buono regalo">
        <CartaBuono class="bb-c bb-c1" valore={25} tema="cantiere" piccola />
        <CartaBuono class="bb-c bb-c2" valore={100} tema="compleanno" piccola />
        <CartaBuono class="bb-c bb-c3" valore={50} tema="natale" piccola />
      </a>
    </div>
  </div>
</section>
<style>
  .bb-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,48px);align-items:center;padding:clamp(20px,4vw,40px);overflow:hidden}
  .bb-k{margin:0;color:var(--mut)}
  .bb-h{margin:6px 0 10px;line-height:1.02}
  .bb-d{color:var(--mut);margin:0 0 18px;max-width:520px}
  .bb-tagli{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
  .bb-t{min-height:44px;display:inline-flex;align-items:center;padding:0 18px;border-radius:8px;background:var(--bg);border:1px solid var(--line);font-weight:800;color:var(--ink)}
  .bb-t:hover{border-color:var(--y);background:#fffbea;color:var(--ink)}.bb-alt{font-weight:700;color:var(--mut)}
  .bb-stack{position:relative;display:block;height:clamp(230px,26vw,300px)}
  .bb-stack :global(.bb-c){position:absolute;width:min(78%,330px);transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .bb-stack :global(.bb-c1){left:0;top:0;transform:rotate(-8deg)}
  .bb-stack :global(.bb-c2){right:0;top:4%;transform:rotate(7deg)}
  .bb-stack :global(.bb-c3){left:11%;bottom:0;z-index:2}
  .bb-stack:hover :global(.bb-c1){transform:rotate(-12deg) translate(-10px,-4px)}
  .bb-stack:hover :global(.bb-c2){transform:rotate(11deg) translate(10px,-4px)}
  .bb-stack:hover :global(.bb-c3){transform:translateY(-8px)}
  @media (max-width:860px){.bb-in{grid-template-columns:1fr}.bb-stack{height:min(62vw,280px);max-width:440px;width:100%;margin:0 auto}}
</style>
