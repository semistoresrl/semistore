---
// Copertina cliccabile delle Offerte Flash DEWALT (in home). Nascosta di default:
// si mostra solo se /api/offerta dice che l'offerta è attiva e "scade" non è passato.
import { OFFERTA, visibileAlBuild } from '../data/offerta.js';
const ofVis = visibileAlBuild();
import prodotti from '../data/prodotti.json';
import { fotoDi } from '../data/foto';
const foto = ['DCF850P2T', 'DCD805P2T', 'DCG405P2']
  .map((m) => prodotti.find((p) => p.modello === m)).filter(Boolean)
  .map((p: any) => fotoDi(p.slug, 400) || p.immagineDewalt).filter(Boolean).slice(0, 3);
---
{OFFERTA.attiva && (
  <section class="of-w" data-offerta data-scade={OFFERTA.scade} data-inizio={OFFERTA.inizio} hidden={!ofVis}>
    <div class="wrap">
      <a class="of" href={OFFERTA.url} target="_blank" rel="noopener">
        <span class="of-bg" aria-hidden="true"></span>
        <span class="of-t">
          <span class="of-k"><i aria-hidden="true"></i><span data-of-k>Offerta a tempo · attiva ora</span></span>
          <b class="of-h">Offerte<br /><span>Flash</span> ⚡</b>
          {OFFERTA.marchi && <span class="of-m">{OFFERTA.marchi.join(' · ')}</span>}
          <span class="of-s" data-of-sotto>{OFFERTA.sottotitolo}</span>
          <span class="of-cd" data-of-box hidden={!ofVis}>
            <span class="of-cd-l" data-of-lab>Termina tra</span>
            <span class="of-cd-r mono">
              <span><b data-u="g">00</b><small>giorni</small></span><i>:</i>
              <span><b data-u="h">00</b><small>ore</small></span><i>:</i>
              <span><b data-u="m">00</b><small>min</small></span><i>:</i>
              <span><b data-u="s">00</b><small>sec</small></span>
            </span>
          </span>
          <span class="of-cta"><span data-of-cta>Scopri le offerte</span> <span aria-hidden="true">→</span></span>
        </span>
        <span class="of-v" aria-hidden="true">
          {foto.map((u, i) => <span class={`of-p of-p${i}`}><img src={u} alt="" loading="lazy" decoding="async" /></span>)}
          <span class="of-badge"><small>fino al</small>{OFFERTA.sconto || 'FLASH'}</span>
        </span>
      </a>
    </div>
  </section>
)}

<style>
  .of-w{padding:28px 0 4px}
  .of{position:relative;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:24px;min-height:320px;background:var(--ink);color:#fff;border-radius:22px;overflow:hidden;padding:clamp(24px,4vw,48px);box-shadow:0 24px 50px #0003;isolation:isolate;transition:transform .2s,box-shadow .2s}
  .of:hover{color:#fff;transform:translateY(-3px);box-shadow:0 30px 60px #0004}
  .of-bg{position:absolute;inset:0;z-index:-1;background:repeating-linear-gradient(-45deg,transparent 0 22px,#ffffff06 22px 44px)}
  .of-bg::after{content:'';position:absolute;top:-20%;bottom:-20%;right:-8%;width:52%;background:var(--y);transform:skewX(-12deg)}
  .of-t{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
  .of-k{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--y);border:1px solid #f5b80066;padding:6px 10px;border-radius:4px}
  .of-k i{width:8px;height:8px;border-radius:50%;background:#ff3b30;box-shadow:0 0 0 0 #ff3b3088;animation:ofp 1.6s infinite}
  @keyframes ofp{70%{box-shadow:0 0 0 8px #ff3b3000}100%{box-shadow:0 0 0 0 #ff3b3000}}
  .of-h{font-size:clamp(34px,6vw,76px);line-height:.9;text-transform:uppercase;font-weight:900;letter-spacing:-.01em}
  .of-h span{color:var(--y);font-style:italic}
  .of-s{color:#c9cbcf;font-size:17px;max-width:440px}
  .of-cd{display:flex;flex-direction:column;gap:6px}
  .of-cd[hidden]{display:none}
  .of-cd-l{font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#c9cbcf}
  .of-cd-r{display:flex;align-items:flex-start;gap:6px}
  .of-cd-r>span{display:flex;flex-direction:column;align-items:center;min-width:64px;background:#ffffff10;border:1px solid #ffffff22;border-radius:10px;padding:8px 6px 6px}
  .of-cd-r b{font-size:clamp(26px,3.4vw,38px);line-height:1;color:var(--y);font-weight:800;font-variant-numeric:tabular-nums}
  .of-cd-r small{font-size:11px;color:#b9bbbf;text-transform:uppercase;letter-spacing:.08em;margin-top:4px;font-family:'Archivo Variable',system-ui,sans-serif}
  .of-cd-r i{font-style:normal;font-size:26px;font-weight:800;color:#ffffff55;padding-top:8px}
  .of.prossima .of-k i{background:var(--y);box-shadow:none;animation:none}
  @media (max-width:420px){.of-cd-r>span{min-width:0;flex:1}.of-cd-r i{display:none}}
  .of-cta{margin-top:4px;background:var(--y);color:var(--ink);font-weight:900;font-size:17px;padding:14px 22px;border-radius:10px;text-transform:uppercase;letter-spacing:.02em}
  .of:hover .of-cta span{display:inline-block;transform:translateX(4px)}
  .of-v{position:relative;height:300px}
  .of-p{position:absolute;background:#fff;border-radius:16px;padding:14px;box-shadow:0 20px 40px #0006;display:block}
  .of-p img{width:100%;height:100%;object-fit:contain;display:block}
  .of-p0{width:56%;aspect-ratio:1;left:22%;top:4%;z-index:2;animation:off 6s ease-in-out infinite}
  .of-p1{width:38%;aspect-ratio:1;left:0;bottom:0;transform:rotate(-8deg);animation:off 6s -2s ease-in-out infinite}
  .of-p2{width:38%;aspect-ratio:1;right:0;bottom:6%;transform:rotate(7deg);animation:off 6s -4s ease-in-out infinite}
  @keyframes off{50%{translate:0 -8px}}
  .of-badge{position:absolute;z-index:3;right:4%;top:0;width:104px;height:104px;border-radius:50%;background:#e30613;color:#fff;display:grid;place-content:center;text-align:center;font-weight:900;font-size:28px;line-height:1;transform:rotate(12deg);box-shadow:0 10px 24px #0005}
  .of-badge small{font-size:11px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}
  .of-m{font-weight:900;font-size:clamp(14px,1.6vw,18px);letter-spacing:.06em;color:#fff;border-top:2px solid var(--y);padding-top:8px}
  @media (max-width:760px){
    .of{grid-template-columns:1fr;min-height:0;gap:8px}
    .of-v{order:-1;height:200px}
    .of-bg::after{top:-40px;bottom:auto;height:250px;right:-30%;width:100%}
    .of-badge{width:76px;height:76px;font-size:16px}
    .of-cta{align-self:stretch;text-align:center}
  }
  @media (prefers-reduced-motion:reduce){.of-p,.of-k i{animation:none}.of:hover{transform:none}}
</style>
