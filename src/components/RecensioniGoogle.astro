---
// Valutazione e ultime recensioni della scheda Google (caricate da /api/google, nascoste se non disponibili).
// Le schede sono create dallo script: per questo gli stili sono globali (prefisso rg-).
import { GOOGLE } from '../data/sito.js';
---
<section class="rg wrap sec" id="recensioni" hidden data-scrivi={GOOGLE.recensione}>
  <div class="rg-h">
    <div>
      <p class="rg-k">Recensioni Google</p>
      <h2 class="h2">Cosa dicono di noi</h2>
    </div>
    <a class="rg-sum" target="_blank" rel="noopener">
      <svg class="rg-g" viewBox="0 0 48 48" width="34" height="34" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
      <span class="rg-sum-t"><span class="rg-sum-r"><b class="rg-v"></b><span class="rg-s"></span></span><span class="rg-n"></span></span>
    </a>
  </div>
  <div class="rg-l" id="rg-l"></div>
  <div class="rg-f">
    <span class="rg-nav"><button type="button" class="rg-b" data-rg="-1" aria-label="Recensione precedente">‹</button><button type="button" class="rg-b" data-rg="1" aria-label="Recensione successiva">›</button></span>
    <a class="btn btn-k" href={GOOGLE.recensione} target="_blank" rel="noopener">Lascia una recensione</a>
  </div>
</section>
<script>
  const sec = document.querySelector<HTMLElement>('.rg');
  const stelle = (n: number) => '★'.repeat(Math.round(n)) + '<i>' + '★'.repeat(5 - Math.round(n)) + '</i>';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const colori = ['#f5b800', '#15171a', '#1a7a43', '#8a6600', '#3b5bdb'];
  if (sec) fetch('/api/google').then((r) => r.json()).then((g) => {
    if (!g.ok || !g.voto || !g.recensioni?.length) return;
    const sum = sec.querySelector<HTMLAnchorElement>('.rg-sum')!;
    sum.href = g.link || sec.dataset.scrivi!;
    sec.querySelector('.rg-v')!.textContent = g.voto.toFixed(1).replace('.', ',');
    sec.querySelector('.rg-s')!.innerHTML = stelle(g.voto);
    sec.querySelector('.rg-n')!.textContent = `${g.totale} recensioni su Google`;
    const l = sec.querySelector<HTMLElement>('.rg-l')!;
    l.innerHTML = g.recensioni.map((x: any, i: number) => `
      <figure class="rg-c">
        <span class="rg-q" aria-hidden="true">“</span>
        <div class="rg-st" aria-label="${x.voto} stelle su 5">${stelle(x.voto)}</div>
        <blockquote class="rg-t">${esc(x.testo)}</blockquote>
        <button type="button" class="rg-more" hidden>Leggi tutto</button>
        <figcaption class="rg-a">
          ${x.foto ? `<img src="${esc(x.foto)}" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer">` : `<span class="rg-i" style="background:${colori[i % colori.length]}">${esc((x.nome[0] || 'G').toUpperCase())}</span>`}
          <span><b>${esc(x.nome)}</b><small>${esc(x.quando)} · Google</small></span>
        </figcaption>
      </figure>`).join('');
    sec.hidden = false;
    // "Leggi tutto" solo dove il testo è tagliato
    l.querySelectorAll<HTMLElement>('.rg-c').forEach((c) => {
      const t = c.querySelector<HTMLElement>('.rg-t')!, b = c.querySelector<HTMLButtonElement>('.rg-more')!;
      if (t.scrollHeight > t.clientHeight + 2) { b.hidden = false; b.onclick = () => { const o = c.classList.toggle('open'); b.textContent = o ? 'Mostra meno' : 'Leggi tutto'; }; }
    });
    sec.querySelectorAll<HTMLButtonElement>('[data-rg]').forEach((b) => b.addEventListener('click', () => l.scrollBy({ left: Number(b.dataset.rg) * (l.firstElementChild as HTMLElement).offsetWidth + Number(b.dataset.rg) * 16 })));
  }).catch(() => {});
</script>
<style is:global>
  .rg-h{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:22px}
  .rg-k{margin:0 0 4px;font-weight:700;color:var(--mut);font-size:14px;text-transform:uppercase;letter-spacing:.06em}
  .rg-sum{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 18px;box-shadow:0 8px 20px #0000000a}.rg-sum:hover{color:inherit;border-color:var(--y)}
  .rg-sum-t{display:flex;flex-direction:column;line-height:1.15}.rg-sum-r{display:flex;align-items:center;gap:10px}
  .rg-v{font-size:30px;font-weight:900}.rg-s,.rg-st{color:#f5b400;letter-spacing:2px;font-size:20px}.rg-s i,.rg-st i{font-style:normal;color:#ddd9cf}
  .rg-n{color:var(--mut);font-size:13.5px;font-weight:600}
  .rg-l{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 32px)/3);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:4px 2px 12px;align-items:start}
  .rg-l::-webkit-scrollbar{display:none}
  .rg-c{position:relative;margin:0;scroll-snap-align:start;background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 22px 18px;display:flex;flex-direction:column;gap:12px;box-shadow:0 10px 24px #0000000a;min-height:100%}
  .rg-q{position:absolute;right:16px;top:-6px;font-size:84px;line-height:1;font-weight:900;color:var(--y);opacity:.35;font-family:Georgia,serif}
  .rg-st{font-size:18px}
  .rg-t{margin:0;font-size:15.5px;line-height:1.55;color:#2b2d31;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
  .rg-c.open .rg-t{-webkit-line-clamp:unset;display:block}
  .rg-more{align-self:flex-start;background:none;border:0;padding:0;font:inherit;font-size:14px;font-weight:800;color:var(--y-d);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
  .rg-a{display:flex;gap:12px;align-items:center;margin-top:auto;padding-top:14px;border-top:1px solid var(--line)}
  .rg-a img,.rg-i{flex:0 0 40px;width:40px;height:40px;border-radius:50%;object-fit:cover}
  .rg-i{display:grid;place-items:center;color:#fff;font-weight:800;font-size:17px}
  .rg-a b{display:block;font-size:15px;line-height:1.2}.rg-a small{display:block;color:var(--mut);font-size:13px}
  .rg-f{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}
  .rg-nav{display:flex;gap:8px}.rg-b{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:#fff;font-size:24px;line-height:1;cursor:pointer;color:var(--ink)}.rg-b:hover{border-color:var(--y)}
  @media (max-width:900px){.rg-l{grid-auto-columns:calc((100% - 16px)/2)}}
  @media (max-width:600px){.rg-l{grid-auto-columns:86%;gap:12px}.rg-c{padding:20px 18px 16px}.rg-nav{display:none}.rg-f .btn{width:100%}.rg-sum{width:100%}}
</style>
