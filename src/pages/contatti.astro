---
import Base from '../layouts/Base.astro';
import { SITO, GOOGLE } from '../data/sito.js';
import ApertoOra from '../components/ApertoOra.astro';
import VideoNegozio from '../components/VideoNegozio.astro';
import RecensioniGoogle from '../components/RecensioniGoogle.astro';
---
<Base image="/og/contatti.jpg" title="Contatti e dove siamo" description={`Semi Store, ${SITO.indirizzo}, ${SITO.citta} (${SITO.provincia}). Telefono ${SITO.telefono}. Vendita e assistenza autorizzata.`}>
  <section class="wrap sec">
    <h1 class="h2" style="margin-bottom:24px">Contatti</h1>
    <div class="cgrid">
      <div class="card box">
        <h2>Negozio e laboratorio</h2>
        <p style="margin:0">{SITO.ragioneSociale}<br />{SITO.indirizzo}<br />{SITO.cap} {SITO.citta} ({SITO.provincia})</p>
        <a class="btn btn-k" href={GOOGLE.indicazioni} target="_blank" rel="noopener">Indicazioni stradali</a>
        <a class="btn btn-k" href={GOOGLE.scheda} target="_blank" rel="noopener">Apri su Google Maps</a>
      </div>
      <div class="card box">
        <h2>Scrivici o chiamaci</h2>
        <a class="btn btn-y" href={`tel:${SITO.telefonoLink}`}>Chiama {SITO.telefono}</a>
        <a class="btn btn-k" href={`mailto:${SITO.email}`}>{SITO.email}</a>
        {SITO.whatsapp && <a class="btn btn-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITO.whatsapp.slice(2).replace(/(\d{3})(\d{3})(\d+)/, '$1 $2 $3')}</a>}
      </div>
      {SITO.orari.length > 0 && (
        <div class="card box">
          <h2>Orari</h2>
          <ApertoOra chiaro />
          {SITO.orari.map((o) => <p style="margin:0"><b>{o.giorni}</b> {o.ore}</p>)}
          <a class="btn btn-k" href={GOOGLE.recensione} target="_blank" rel="noopener">Lascia una recensione su Google</a>
        </div>
      )}
    </div>
    <div class="map card" id="mappa" data-src={GOOGLE.mappa}>
      <!-- La mappa Google si carica solo su richiesta: Google Maps usa cookie propri (linee guida Garante privacy 2021) -->
      <button type="button" class="map-ph" id="mappa-btn">
        <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path fill="#f5b800" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
        <b>Mostra la mappa</b>
        <span>Viale G. Marconi 225, Casavatore (NA)</span>
        <small>Caricando la mappa, Google può impostare i propri cookie. <a href="/privacy/#cookie">Informativa</a></small>
      </button>
    </div>
    <script>
      const m = document.getElementById('mappa'), b = document.getElementById('mappa-btn');
      b?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) return; const f = document.createElement('iframe'); f.src = m!.dataset.src!; f.title = 'Mappa: Semi Store a Casavatore'; f.allowFullscreen = true; f.referrerPolicy = 'no-referrer-when-downgrade'; m!.replaceChildren(f); });
    </script>
  </section>
  <RecensioniGoogle />
  <VideoNegozio titolo="Come arrivare" />
</Base>
<style>.cgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:20px}.box{padding:24px;display:flex;flex-direction:column;gap:14px}.box h2{font-size:22px}.map{margin-top:20px;overflow:hidden;padding:0;width:100%;aspect-ratio:16/7;min-height:300px}@media (max-width:760px){.map{aspect-ratio:auto;height:clamp(300px,80vw,420px)}}.map iframe{width:100%;height:100%;border:0;display:block}.map-ph{width:100%;height:100%;border:0;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:#23262b url('/video/negozio-poster.jpg') center/cover;background-blend-mode:multiply;color:#fff;font:inherit;padding:20px;text-align:center}.map-ph b{font-size:20px}.map-ph small{color:#c9cbcf;max-width:420px}.map-ph a{color:#fff;text-decoration:underline}</style>
