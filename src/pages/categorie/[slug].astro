---
// Pagina di una categoria: indicizzabile da Google, con testo, filtri rapidi e prodotti (48 nell'HTML, gli altri su richiesta).
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { ordinati, slugCategoria, urlCategoria, ORDINE_CAT } from '../../data/catalogo';
import { TESTI } from '../../data/categorie';
import { SITO, euro } from '../../data/sito.js';
export function getStaticPaths() {
  const cats = [...new Set(ordinati.map((p: any) => p.categoria))];
  return cats.map((c) => ({ params: { slug: slugCategoria(c) }, props: { c } }));
}
const { c } = Astro.props as { c: string };
const PAG = 48;
const lista = ordinati.filter((p: any) => p.categoria === c);
const testo = TESTI[c] || { t: c, d: `${c}: ${lista.length} prodotti DEWALT, STANLEY e BLACK+DECKER.`, intro: '' };
const marche = [...new Set(lista.map((p: any) => p.marca))];
const volts = ['12V', '18V', '36V', '54V', '230V'].filter((v) => lista.some((p: any) => p.volt === v));
const prezzi = lista.map((p: any) => p.prezzo);
const altre = ORDINE_CAT.filter((x) => x !== c && ordinati.some((p: any) => p.categoria === x));
const url = `${SITO.url}${urlCategoria(c)}`;
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITO.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Catalogo', item: SITO.url + '/catalogo/' },
    { '@type': 'ListItem', position: 3, name: c, item: url } ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: testo.t, description: testo.d, url,
    mainEntity: { '@type': 'ItemList', numberOfItems: lista.length, itemListElement: lista.slice(0, PAG).map((p: any, i: number) => ({ '@type': 'ListItem', position: i + 1, url: `${SITO.url}/prodotti/${p.slug}/` })) } },
];
---
<Base title={testo.t} description={testo.d} jsonld={ld}>
  <section class="wrap sec cp">
    <nav aria-label="Percorso" class="bc"><a href="/">Home</a> / <a href="/catalogo/">Catalogo</a> / <span>{c}</span></nav>
    <div class="cp-h">
      <h1 class="h2">{c}</h1>
      <span class="cp-n">{lista.length} prodotti · da {euro(Math.min(...prezzi))}</span>
    </div>
    {testo.intro && <p class="cp-i">{testo.intro}</p>}
    <div class="cp-f" role="group" aria-label="Filtra">
      {(marche.length > 1 || volts.length > 1) && <button type="button" class="chip on" data-f="">Tutti</button>}
      {marche.length > 1 && marche.map((m) => <button type="button" class="chip" data-f={`b:${m}`}>{m}</button>)}
      {volts.length > 1 && volts.map((v) => <button type="button" class="chip" data-f={`v:${v}`}>{v === '230V' ? 'A filo' : v === '54V' ? '54V FLEXVOLT' : v}</button>)}
      <select class="chip cp-o" aria-label="Ordina"><option value="">Consigliati</option><option value="asc">Prezzo crescente</option><option value="desc">Prezzo decrescente</option></select>
    </div>
    <div class="grid-p" id="g" data-cat={c}>{lista.slice(0, PAG).map((p: any, i: number) => <ProductCard p={p} eager={i < 4} />)}</div>
    {lista.length > PAG && <div style="text-align:center;margin-top:24px"><button class="btn btn-k" id="piu">Mostra altri prodotti</button></div>}
    <div class="cp-alt">
      <h2>Altre categorie</h2>
      <div class="cp-al">{altre.map((x) => <a href={urlCategoria(x)} class="chip">{x}</a>)}</div>
    </div>
  </section>
</Base>
<script>
  import { card, indice } from '../../scripts/card.js';
  const g = document.getElementById('g')!; const cat = g.dataset.cat!;
  const piu = document.getElementById('piu') as HTMLButtonElement | null;
  const ord = document.querySelector<HTMLSelectElement>('.cp-o')!;
  let f = '', lim = 48, toccato = false;
  async function run() {
    toccato = true;
    const l = (await indice()).filter((x: any) => x.c === cat && (!f || (f[0] === 'b' ? x.b : x.v) === f.slice(2)));
    const o = ord.value; const r = o ? [...l].sort((a, b) => (o === 'asc' ? 1 : -1) * (a.p - b.p)) : l;
    g.innerHTML = r.slice(0, lim).map(card).join('');
    if (piu) piu.hidden = r.length <= lim;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-f]').forEach((x) => x.classList.toggle('on', x === b)); f = b.dataset.f || ''; lim = 48; run();
  }));
  ord.addEventListener('change', () => { lim = 48; run(); });
  piu?.addEventListener('click', () => { lim += 48; run(); });
</script>
<style>
  .cp-h{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px;margin:6px 0 12px}
  .cp-n{color:var(--mut);font-weight:700}
  .cp-i{max-width:820px;margin:0 0 18px;color:#33363b;font-size:16.5px}
  .cp-f{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px;margin-bottom:18px}.cp-f::-webkit-scrollbar{display:none}
  .chip{flex:0 0 auto;min-height:40px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:#fff;font:inherit;font-size:14px;font-weight:700;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center}
  .chip:hover{border-color:var(--y);color:var(--ink)}.chip.on{background:var(--ink);color:var(--y);border-color:var(--ink)}
  .cp-o{margin-left:auto}
  .cp-alt{margin-top:48px}.cp-alt h2{font-size:22px;margin-bottom:12px}
  .cp-al{display:flex;flex-wrap:wrap;gap:8px}
  .bc{font-size:14px;color:var(--mut)}.bc a{text-decoration:underline;text-underline-offset:3px}
</style>
