---
import Base from '../layouts/Base.astro';
import { SITO } from '../data/sito.js';
---
<Base title="Carrello" noindex>
  <section class="wrap sec">
    <h1 class="h2" style="margin-bottom:24px">Carrello</h1>
    <div class="cart">
      <div id="righe" class="card righe"><p style="padding:20px;margin:0">Caricamento…</p></div>
      <aside class="card tot">
        <div class="fs" id="fs" hidden><span id="fs-t"></span><span class="fs-b"><i id="fs-i"></i></span></div>
        <div class="row between"><span>Subtotale</span><b id="sub">–</b></div>
        <fieldset class="cons">
          <legend>Consegna</legend>
          <label><input type="radio" name="cons" value="spedizione" checked /> Spedizione ({SITO.spedizione.giorni} giorni)</label>
          <label><input type="radio" name="cons" value="ritiro" /> Ritiro in negozio a {SITO.citta} (gratis)</label>
        </fieldset>
        <div class="wal" id="wal" hidden></div>
        <details class="cod" id="cod">
          <summary>Hai un codice sconto o un buono?</summary>
          <div class="cod-r"><input id="cod-i" class="mono" placeholder="GIOCO-… o SEMI-XXXX-XXXX-XXXX" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Codice sconto o buono" /><button type="button" id="cod-b" class="btn">Applica</button></div>
          <small id="cod-m" role="status"></small>
          <div id="cod-l" class="cod-l"></div>
        </details>
        <div class="row between" id="sc-r" hidden><span>Sconto premio −<span id="sc-p">10</span>%</span><b id="sc" style="color:var(--ok)">–</b></div>
        <div class="row between" id="bp-r" hidden><span>Buono punti <small>(prodotti Catalogo Premi)</small></span><b id="bp" style="color:var(--ok)">–</b></div>
        <div class="row between" id="br-r" hidden><span>Buono regalo</span><b id="br" style="color:var(--ok)">–</b></div>
        <div class="row between"><span>Consegna</span><b id="sped">–</b></div>
        <div class="row between big"><span>Totale</span><b id="tot">–</b></div>
        <div class="ptc" id="ptc" hidden></div>
        <button id="paga" class="btn btn-y" disabled>Procedi al pagamento</button>
        <p class="cg-n">Proseguendo accetti le <a class="ul" href="/condizioni-di-vendita/">condizioni di vendita</a> (recesso 14 giorni, garanzia legale 2 anni) e prendi visione dell'<a class="ul" href="/privacy/">informativa privacy</a>. L'ordine si conclude con il pagamento sulla pagina sicura di Stripe.</p>
        <p id="err" class="err" role="alert" hidden></p>
        <small style="color:var(--mut)">Pagamento gestito da Stripe: carte, Apple Pay, Google Pay. I dati della carta non passano dal nostro sito.</small>
      </aside>
    </div>
  </section>
</Base>
<script define:vars={{ sp: SITO.spedizione, premi: SITO.punti.prodottiPremio || [] }}>
  window.__SP = sp; window.__PREMI = premi;
</script>
<script>
  import { read, setQty, clear } from '../scripts/cart.js';
  import { track, itemsCarrello } from '../scripts/track.js';
  import { indice } from '../scripts/card.js';
  import { calcolaPunti, prossimoBonus } from '../lib/punti.js';
  const PREMI = new Set<string>((window as any).__PREMI || []);
  type Buono = { codice?: string; id?: string; disponibile: number; soloPremi: boolean; fine: string; usa: boolean };
  const buoni: Buono[] = []; // codici scritti a mano
  let wallet: Buono[] = []; // buoni salvati nell'account
  let io: any = null; // account collegato (per l'anteprima punti)
  const SP = (window as any).__SP;
  let M: Record<string, any> = {};
  let codice = '', pct = 0;
  const eur = (c: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(c / 100);
  const el = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  function render() {
    const items = read().filter((i) => M[i.slug]);
    const box = el('righe');
    if (!items.length) { box.innerHTML = '<p style="padding:24px;margin:0">Il carrello è vuoto. <a class="ul" href="/catalogo/">Vai al catalogo</a></p>'; }
    else box.innerHTML = items.map((i) => { const x = M[i.slug], p = { n: x.n, m: x.m, pr: x.p, img: x.i }; return `<div class="riga">
      ${p.img ? `<img src="${p.img}" width="80" height="80" alt="">` : '<span class="ph"></span>'}
      <a href="/prodotti/${i.slug}/" class="rn"><b>${esc(p.n)}</b><small class="mono">${esc(p.m || '')}</small></a>
      <label class="rq"><span class="sr">Quantità</span><input type="number" min="0" max="20" value="${i.qty}" data-s="${i.slug}"></label>
      <b class="rp">${eur(p.pr * i.qty)}</b>
      <button class="rx" data-x="${i.slug}" aria-label="Rimuovi">✕</button></div>`; }).join('');
    const sub = items.reduce((t, i) => t + M[i.slug].p * i.qty, 0);
    const ritiro = (document.querySelector('input[name=cons]:checked') as HTMLInputElement).value === 'ritiro';
    const sped = !items.length || ritiro || sub >= SP.gratisDa ? 0 : SP.costo;
    // barra "spedizione gratuita": quanto manca alla soglia
    const manca = SP.gratisDa - sub, fs = el('fs');
    fs.hidden = !items.length || ritiro;
    el('fs-t').innerHTML = manca > 0 ? `Ti mancano <b>${eur(manca)}</b> per la spedizione gratuita` : '<b>Spedizione gratuita</b> sbloccata ✓';
    (el('fs-i') as HTMLElement).style.width = Math.min(100, (sub / SP.gratisDa) * 100) + '%';
    fs.classList.toggle('ok', manca <= 0);
    const sc = codice ? Math.round(sub * pct / 100) : 0;
    // stesso calcolo del server: prima lo sconto del gioco, poi i buoni (quelli punti solo sui prodotti del Catalogo Premi)
    const subPremi = items.filter((i) => PREMI.has(i.slug)).reduce((t, i) => t + M[i.slug].p * i.qty, 0);
    let resto = sub - sc, restoPremi = Math.round(subPremi * (sub ? (sub - sc) / sub : 1)), usoP = 0, usoR = 0;
    for (const b of [...wallet.filter((w) => w.usa), ...buoni]) {
      const uso = Math.max(0, Math.min(b.disponibile, b.soloPremi ? Math.min(resto, restoPremi) : resto));
      resto -= uso; if (b.soloPremi) { restoPremi -= uso; usoP += uso; } else { restoPremi = Math.min(restoPremi, resto); usoR += uso; }
    }
    el('sc-r').hidden = !sc; el('sc').textContent = '−' + eur(sc);
    el('bp-r').hidden = !usoP; el('bp').textContent = '−' + eur(usoP);
    el('br-r').hidden = !usoR; el('br').textContent = '−' + eur(usoR);
    el('sub').textContent = eur(sub); el('sped').textContent = sped ? eur(sped) : 'Gratis'; el('tot').textContent = eur(sub - sc - usoP - usoR + sped);
    // anteprima Punti Semi
    const base = Math.max(0, sub - sc - usoP), ptc = el('ptc');
    ptc.hidden = !items.length;
    if (items.length) {
      const c = calcolaPunti({ base, spesaPrima: io?.punti?.spesa || 0, primo: io ? !io.punti?.ordini : true });
      const nb = prossimoBonus(base);
      ptc.innerHTML = (io
        ? `<b>+${c.punti.toLocaleString('it-IT')} Punti Semi</b> con questo ordine <small>(livello ${c.livello.nome})</small>`
        : `<b>Guadagna ${c.punti.toLocaleString('it-IT')} Punti Semi</b> con questo ordine: <a class="ul" href="/account/?dopo=/carrello/">entra o registrati</a>`)
        + (nb ? `<span class="ptc-h">Aggiungi <b>${eur(nb.da - base)}</b> e ottieni il <b>bonus carrello +${nb.pct}%</b> punti</span>` : '')
        + `<a class="ptc-l" href="/punti/">Come funzionano i punti</a>`;
    }
    (el('paga') as HTMLButtonElement).disabled = !items.length;
  }
  el('righe').addEventListener('change', (e) => { const t = e.target as HTMLInputElement; if (t.dataset.s) { setQty(t.dataset.s, Math.round(Number(t.value))); render(); } });
  el('righe').addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest('[data-x]') as HTMLElement; if (t) { setQty(t.dataset.x!, 0); render(); } });
  document.querySelectorAll('input[name=cons]').forEach((r) => r.addEventListener('change', render));
  el('paga').addEventListener('click', async () => {
    const b = el('paga') as HTMLButtonElement; b.disabled = true; b.textContent = 'Un attimo…'; el('err').hidden = true;
    try {
      const consegna = (document.querySelector('input[name=cons]:checked') as HTMLInputElement).value;
      try { const its = await itemsCarrello(read()); track('begin_checkout', { items: its, value: its.reduce((t, i) => t + i.prezzo * i.qty, 0) }); } catch {}
      const r = await fetch('/api/checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ items: read(), consegna, codice, buoni: buoni.map((b) => b.codice), buoniAccount: wallet.filter((w) => w.usa).map((w) => w.id) }) });
      const j = await r.json();
      if (r.status === 401 && j.accedi) { // sconto del minigioco: serve l'account con la stessa email
        el('err').innerHTML = `${j.error} <a class="ul" href="/account/?dopo=${encodeURIComponent('/carrello/?codice=' + codice)}">Entra ora</a>`;
        el('err').hidden = false; b.disabled = false; b.textContent = 'Procedi al pagamento'; return;
      }
      if (!r.ok || !j.url) throw new Error(j.error || 'Errore');
      location.href = j.url;
    } catch (e: any) { el('err').textContent = 'Non riusciamo ad avviare il pagamento: ' + e.message + '. Riprova o chiamaci.'; el('err').hidden = false; b.disabled = false; b.textContent = 'Procedi al pagamento'; }
  });
  // codice sconto (premio del minigioco in home): si compila da solo se è stato vinto su questo dispositivo
  const codM = el('cod-m'), codI = el('cod-i') as HTMLInputElement;
  const listaCodici = () => {
    el('cod-l').innerHTML = [
      ...(codice ? [`<span class="cl">Premio gioco −${pct}% <button type="button" data-tg aria-label="Togli">✕</button></span>`] : []),
      ...buoni.map((b, i) => `<span class="cl">Buono …${b.fine} · ${eur(b.disponibile)} <button type="button" data-tb="${i}" aria-label="Togli">✕</button></span>`),
    ].join('');
  };
  el('cod-l').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.dataset.tg != null) { codice = ''; pct = 0; }
    if (t.dataset.tb != null) buoni.splice(Number(t.dataset.tb), 1);
    listaCodici(); render();
  });
  async function applicaBuono(c: string) {
    codM.textContent = 'Controllo…'; codM.className = '';
    try {
      const j = await (await fetch('/api/buoni/verifica?codice=' + encodeURIComponent(c))).json();
      if (j.valido) {
        if (buoni.some((b) => b.fine === j.fine) || wallet.some((w) => w.fine === j.fine && w.usa)) { codM.textContent = 'Questo buono è già applicato.'; codM.className = 'no'; return; }
        buoni.push({ codice: c, disponibile: j.disponibile, soloPremi: j.soloPremi, fine: j.fine, usa: true });
        codM.textContent = j.soloPremi ? `Buono punti applicato ✓ (vale sui prodotti del Catalogo Premi)` : `Buono applicato ✓ disponibili ${eur(j.disponibile)}`; codM.className = 'ok'; codI.value = '';
      } else { codM.textContent = j.error || (j.esaurito ? 'Questo buono è già stato speso tutto.' : 'Codice non valido: controlla di averlo scritto bene.'); codM.className = 'no'; }
    } catch { codM.textContent = 'Non riusciamo a controllare il codice ora.'; codM.className = 'no'; }
    listaCodici(); render();
  }
  async function applica(c: string, zitto = false) {
    c = c.trim().toUpperCase(); if (!c) return;
    if (/^SEMI/.test(c.replace(/[^A-Z0-9]/g, ''))) return applicaBuono(c);
    codM.textContent = 'Controllo…'; codM.className = '';
    try {
      const j = await (await fetch('/api/premio?codice=' + encodeURIComponent(c))).json();
      if (j.valido) { codice = c; pct = j.sconto; el('sc-p').textContent = String(pct); codM.textContent = `Codice applicato: −${pct}% sui prodotti ✓`; codM.className = 'ok'; (el('cod') as HTMLDetailsElement).open = true; }
      else { codice = ''; pct = 0; codM.textContent = zitto ? '' : (j.usato ? 'Questo codice è già stato usato.' : 'Codice non valido o scaduto.'); codM.className = 'no'; }
    } catch { codM.textContent = 'Non riusciamo a controllare il codice ora.'; codM.className = 'no'; }
    listaCodici(); render();
  }
  // account collegato: anteprima punti e buoni salvati (si applicano con un tocco)
  fetch('/api/account/io', { cache: 'no-store' }).then((r) => r.ok ? r.json() : null).then(async (j) => {
    if (!j?.collegato) return;
    io = j;
    const m = await (await fetch('/api/buoni/miei', { cache: 'no-store' })).json().catch(() => ({ buoni: [] }));
    wallet = (m.buoni || []).filter((b: any) => b.disponibile > 0).map((b: any) => ({ id: b.id, disponibile: b.disponibile, soloPremi: b.soloPremi, fine: b.fine, usa: true }));
    disegnaWallet(); render();
  }).catch(() => {});
  function disegnaWallet() {
    const w = el('wal');
    w.hidden = !wallet.length;
    w.innerHTML = '<b>I tuoi buoni</b>' + wallet.map((b, i) => `<label class="wl"><input type="checkbox" data-w="${i}" ${b.usa ? 'checked' : ''}> ${b.soloPremi ? 'Buono punti' : 'Buono regalo'} …${b.fine} <span>${eur(b.disponibile)}</span></label>`).join('');
  }
  el('wal').addEventListener('change', (e) => { const t = e.target as HTMLInputElement; if (t.dataset.w != null) { wallet[Number(t.dataset.w)].usa = t.checked; render(); } });
  el('cod-b').addEventListener('click', () => applica(codI.value));
  codI.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); applica(codI.value); } });
  // 1) link "Riscatta lo sconto" dall'email: /carrello/?codice=GIOCO-XXXXXXX  2) codice vinto su questo dispositivo
  const daLink = (new URL(location.href).searchParams.get('codice') || '').trim().toUpperCase();
  if (/^SEMI/.test(daLink)) { (el('cod') as HTMLDetailsElement).open = true; applicaBuono(daLink); history.replaceState(null, '', location.pathname); }
  else if (/^GIOCO-[A-Z0-9]{7}$/.test(daLink)) { codI.value = daLink; applica(daLink); history.replaceState(null, '', location.pathname); }
  else try {
    const g = JSON.parse(localStorage.getItem('semi-gioco-v2') || localStorage.getItem('semi-gioco-v1') || 'null');
    if (g?.codice) { codI.value = g.codice; applica(g.codice, true); }
  } catch {}
  if (new URL(location.href).searchParams.get('svuota')) clear();
  el('righe').innerHTML = '<p style="padding:20px;margin:0">Caricamento…</p>';
  indice().then((l: any[]) => { M = Object.fromEntries(l.map((x) => [x.s, x])); render(); }).catch(() => { el('righe').innerHTML = '<p style="padding:20px;margin:0">Non riusciamo a caricare il carrello: ricarica la pagina.</p>'; });
</script>
<style is:global>.cg-n{font-size:12.5px;color:var(--mut);margin:8px 0 0;line-height:1.45}
  #sc-r[hidden],#bp-r[hidden],#br-r[hidden],.ptc[hidden],.wal[hidden]{display:none}
  .cod-l{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.cl{display:inline-flex;align-items:center;gap:6px;background:#e8f5ec;border-radius:999px;padding:4px 6px 4px 12px;font-size:13px;font-weight:700}
  .cl button{border:0;background:#0000000f;border-radius:50%;width:22px;height:22px;cursor:pointer}
  .wal{display:flex;flex-direction:column;gap:6px;background:#fffbea;border:1px solid #f5b80066;border-radius:10px;padding:10px 12px;font-size:14px}
  .wl{display:flex;align-items:center;gap:8px;cursor:pointer}.wl span{margin-left:auto;font-weight:800}
  .ptc{display:flex;flex-direction:column;gap:4px;background:#15171a;color:#fff;border-radius:10px;padding:12px 14px;font-size:14px}.ptc b{color:var(--y)}.ptc small{color:#c9cbcf}
  .ptc .ul,.ptc-l{color:#fff;text-decoration:underline}.ptc-h{color:#e8e9eb}.ptc-l{font-size:12.5px;color:#c9cbcf}
  .fs{display:flex;flex-direction:column;gap:8px;background:#fff8dc;border:1px solid #f5b80066;border-radius:10px;padding:12px;font-size:14px}.fs.ok{background:#e8f5ec;border-color:#1a7a4344}
  .fs-b{height:8px;border-radius:4px;background:#0000000f;overflow:hidden}.fs-b i{display:block;height:100%;background:var(--y);border-radius:4px;transition:width .3s}.fs.ok .fs-b i{background:var(--ok)}
  .cart{display:grid;grid-template-columns:minmax(0,2fr) minmax(min(280px,100%),1fr);gap:20px;align-items:start}
  @media (max-width:820px){.cart{grid-template-columns:1fr}}
  .righe{overflow:hidden}
  .riga{display:grid;grid-template-columns:80px 1fr 72px auto 44px;gap:12px;align-items:center;padding:14px;border-bottom:1px solid var(--line)}
  .riga img,.riga .ph{width:80px;height:80px;object-fit:contain;background:#fff;border-radius:8px}
  .rn{display:flex;flex-direction:column}.rn small{color:var(--mut)}
  .rq input{width:64px;min-height:44px;border:1px solid #cfccc2;border-radius:8px;padding:0 8px;font:inherit}
  .rx{width:44px;height:44px;border:0;background:transparent;cursor:pointer;font-size:16px}
  @media (max-width:560px){.riga{grid-template-columns:64px 1fr 44px}.riga img,.riga .ph{width:64px;height:64px}.rq{grid-column:2}.rp{grid-column:2}}
  .tot{padding:20px;display:flex;flex-direction:column;gap:14px;position:sticky;top:96px}
  @media (max-width:820px),(max-height:500px){.tot{position:static}}
  .cons{border:1px solid var(--line);border-radius:10px;padding:10px 14px;display:flex;flex-direction:column;gap:8px}.cons label{display:flex;gap:8px;align-items:center;min-height:32px}
  .cod summary{cursor:pointer;font-weight:700;font-size:14px}.cod-r{display:flex;gap:8px;margin-top:10px}.cod-r input{flex:1;min-width:0;min-height:44px;border:1px solid #cfccc2;border-radius:8px;padding:0 10px;font-size:15px;text-transform:uppercase}.cod-r .btn{min-height:44px;padding:0 16px;background:var(--ink);color:#fff}.cod small{display:block;margin-top:6px;font-size:13px}.cod small.ok{color:var(--ok);font-weight:700}.cod small.no{color:#b3261e}
  .big{font-size:20px;border-top:1px solid var(--line);padding-top:12px}.err{color:#b3261e;margin:0;font-weight:600}
</style>
