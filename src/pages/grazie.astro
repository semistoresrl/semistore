---
import Base from '../layouts/Base.astro';
import { SITO } from '../data/sito.js';
---
<Base title="Ordine ricevuto" noindex>
  <section class="wrap sec" style="max-width:720px">
    <h1 class="h2">Grazie, ordine ricevuto!</h1>
    <p style="font-size:18px">Ti abbiamo inviato la ricevuta via email. Ti contattiamo appena l'ordine è pronto per la spedizione o il ritiro.</p>
    <p>Per qualsiasi domanda: <a class="ul" href={`tel:${SITO.telefonoLink}`}>{SITO.telefono}</a> · <a class="ul" href={`mailto:${SITO.email}`}>{SITO.email}</a></p>
    <a href="/catalogo/" class="btn btn-y">Torna al catalogo</a>
  </section>
</Base>
<script>
  import { clear, read } from '../scripts/cart.js';
  import { track, itemsCarrello } from '../scripts/track.js';
  // acquisto per Analytics/Meta (una volta sola per ordine), poi svuota il carrello
  const id = new URLSearchParams(location.search).get('s') || '';
  const cart = read();
  (async () => {
    try {
      if (cart.length && id && localStorage.getItem('semi-ord') !== id) {
        const its = await itemsCarrello(cart);
        track('purchase', { items: its, value: its.reduce((t, i) => t + i.prezzo * i.qty, 0), transaction_id: id.slice(-20) });
        localStorage.setItem('semi-ord', id);
      }
    } catch {}
    clear();
  })();
</script>
