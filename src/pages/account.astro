---
// Account cliente: accesso senza password (link via email), registrazione rapida privato / partita IVA
// (con la partita IVA i dati dell'azienda si compilano da soli), punti, sconti e ordini.
import Base from '../layouts/Base.astro';
import { SITO } from '../data/sito.js';
const LIV = SITO.punti.livelli, CONV = SITO.punti.buoni, BC = SITO.punti.bonusCarrello;
const g = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
---
<Base title="Il mio account" description="Entra nel tuo account Semi Store: punti, sconti, ordini e dati per la fattura." noindex>
  <section class="wrap sec acc" id="acc">
    <p class="acc-load" data-v="carica">Caricamento…</p>

    <!-- 1. accesso -->
    <div class="card acc-box" data-v="entra" hidden>
      <h1 class="h2">Entra o registrati</h1>
      <p class="acc-sub">Niente password: scrivi la tua email e ti mandiamo un link. Un clic e sei dentro. Se è la prima volta, l'account si crea da solo.</p>
      <p class="acc-warn" data-scaduto hidden>Il link è scaduto o è già stato usato: chiedine uno nuovo.</p>
      <form data-f="entra" novalidate>
        <label class="field">La tua email<input name="email" type="email" required autocomplete="email" inputmode="email" placeholder="nome@email.it" maxlength="120" data-pf="email" /></label>
        <button class="btn btn-y">Inviami il link</button>
        <p class="acc-err" role="alert" hidden></p>
      </form>
      <div data-inviato hidden>
        <p class="acc-ok">📩 Fatto! Controlla la posta di <b data-em></b> e premi <b>"Entra in Semi Store"</b>. Se non la trovi guarda nello spam.</p>
        <button type="button" class="btn" data-altra>Usa un'altra email</button>
      </div>
      <ul class="acc-pro"><li>Accumuli <b>{SITO.punti.perEuro} punto per ogni euro</b> speso: il 25 dicembre arriva il <a class="ul" href="/punti/">Catalogo Premi 2027</a></li><li>Trovi i tuoi sconti e i tuoi ordini</li><li>Con la partita IVA ricevi la fattura elettronica</li></ul>
    </div>

    <!-- 2. registrazione (prima volta) o modifica dati -->
    <div class="card acc-box" data-v="profilo" hidden>
      <h1 class="h2" data-tit>Completa il tuo account</h1>
      <p class="acc-sub">Account di <b data-em></b>. Bastano pochi secondi.</p>
      <div class="acc-tipo" role="radiogroup" aria-label="Tipo di account">
        <label><input type="radio" name="tipo" value="privato" checked /><span><b>Privato</b><small>Ricevuta per ogni acquisto</small></span></label>
        <label><input type="radio" name="tipo" value="azienda" /><span><b>Partita IVA</b><small>Fattura elettronica</small></span></label>
      </div>
      <form data-f="profilo" novalidate>
        <div data-solo="privato" class="acc-g2">
          <label class="field">Nome *<input name="nome" autocomplete="given-name" maxlength="60" /></label>
          <label class="field">Cognome *<input name="cognome" autocomplete="family-name" maxlength="60" /></label>
        </div>
        <div data-solo="azienda" hidden>
          <label class="field">Partita IVA *<input name="piva" inputmode="numeric" autocomplete="off" maxlength="13" placeholder="11 cifre" /></label>
          <p class="acc-piva" data-piva aria-live="polite"></p>
          <div class="acc-az" data-az hidden>
            <label class="field">Ragione sociale *<input name="ragioneSociale" autocomplete="organization" maxlength="120" /></label>
            <label class="field">Indirizzo della sede *<input name="indirizzo" autocomplete="street-address" maxlength="120" /></label>
            <div class="acc-g3">
              <label class="field">CAP *<input name="cap" inputmode="numeric" autocomplete="postal-code" maxlength="5" /></label>
              <label class="field">Città *<input name="citta" autocomplete="address-level2" maxlength="60" /></label>
              <label class="field">Prov.<input name="provincia" autocomplete="address-level1" maxlength="2" /></label>
            </div>
            <div class="acc-g2">
              <label class="field">Codice destinatario SDI<input name="sdi" maxlength="7" autocomplete="off" placeholder="es. M5UXCR1" /></label>
              <label class="field">PEC<input name="pec" type="email" maxlength="120" autocomplete="off" placeholder="facoltativa" /></label>
            </div>
            <p class="acc-note">Se non hai codice SDI né PEC, la fattura la trovi nel tuo cassetto fiscale dell'Agenzia delle Entrate.</p>
          </div>
        </div>
        <label class="field">Telefono <span class="opz">(facoltativo, per avvisarti quando l'ordine è pronto)</span><input name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" data-pf="telefono" /></label>
        <label class="chk"><input type="checkbox" name="offerte" /> Voglio ricevere offerte e novità di Semi Store (facoltativo)</label>
        <p class="acc-note">Registrandoti accetti le <a class="ul" href="/condizioni-di-vendita/">condizioni di vendita</a> e il <a class="ul" href="/punti/#regolamento">regolamento del programma punti</a>; i dati sono trattati come spiegato nell'<a class="ul" href="/privacy/">informativa privacy</a>.</p>
        <button class="btn btn-y" data-salva>Salva e continua</button>
        <p class="acc-err" role="alert" hidden></p>
      </form>
    </div>

    <!-- 3. area personale -->
    <div data-v="area" hidden>
      <div class="acc-top">
        <div><p class="acc-k">Il mio account</p><h1 class="h2" data-ciao>Ciao</h1><p class="acc-sub" data-chi></p></div>
        <button type="button" class="btn" data-esci>Esci</button>
      </div>
      <div class="acc-cards">
        <div class="card acc-pt">
          <p class="acc-k">Punti Semi</p>
          <b class="acc-pt-n mono" data-punti>0</b>
          <p>{SITO.punti.perEuro} punto per ogni euro speso sui prodotti. Il <b>Catalogo Premi 2027</b> arriva il {g(SITO.punti.catalogo)}; i punti valgono fino al 31 dicembre 2027. <a href="/punti/">Regolamento</a></p>
        </div>
        <div class="card acc-sc"><p class="acc-k">I tuoi sconti</p><div data-sconti></div></div>
      </div>
      <div class="card acc-sez acc-liv"><h2>Il tuo livello</h2><div data-livello></div></div>
      <div class="card acc-sez" id="buoni">
        <h2>I tuoi buoni</h2>
        <div data-buoni></div>
        <form class="acc-add" data-f="aggiungi" novalidate>
          <label class="field">Hai ricevuto un buono? Aggiungilo qui<input name="codice" class="mono" placeholder="SEMI-XXXX-XXXX-XXXX" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
          <button class="btn">Aggiungi</button>
          <p class="acc-err" role="alert" hidden></p>
        </form>
        <div data-acquistati></div>
        <div data-converti></div>
        <p class="acc-note"><a class="ul" href="/buono-regalo/">🎁 Regala un buono a un amico o a un parente</a></p>
      </div>
      <div class="card acc-sez"><h2>I tuoi ordini</h2><div data-ordini></div></div>
      <div class="card acc-sez">
        <h2>I tuoi dati</h2><div data-dati></div>
        <div class="acc-az-b"><button type="button" class="btn" data-modifica>Modifica i dati</button> <button type="button" class="btn btn-lk" data-elimina>Elimina l'account</button></div>
      </div>
    </div>
  </section>
</Base>
<script define:vars={{ LIV, CONV, catalogo: SITO.punti.catalogo }}>window.__P = { LIV, CONV, catalogo };</script>
<script>
  import { precompila, ricorda, capAutomatico, dimenticaCache } from '../scripts/precompila.js';
  import { evento } from '../scripts/track.js';
  dimenticaCache();
  const PX = (window as any).__P;
  const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
  const $$ = (s: string, r: ParentNode = document) => [...r.querySelectorAll<HTMLElement>(s)];
  const u = new URL(location.href);
  const dopo = u.searchParams.get('dopo') || '';
  const vedi = (v: string) => $$('[data-v]').forEach((e) => (e.hidden = e.dataset.v !== v));
  const esc = (t: any) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const eur = (c: number) => (c / 100).toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });
  const data = (s: string) => new Date(s).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
  const errore = (f: HTMLElement, t: string) => { const e = $('.acc-err', f); e.textContent = t; e.hidden = !t; };
  let me: any = null;

  async function carica() {
    const r = await fetch('/api/account/io', { cache: 'no-store' }).catch(() => null);
    if (!r || r.status === 401 || r.status === 503) { mostraEntra(); return; }
    me = await r.json();
    if (!me.profilo.completo || u.searchParams.has('benvenuto')) { mostraProfilo(true); return; }
    mostraArea();
  }

  // ---------- accesso ----------
  function mostraEntra() {
    vedi('entra');
    if (u.searchParams.get('link') === 'scaduto') $('[data-scaduto]').hidden = false;
    let em = ''; try { em = JSON.parse(localStorage.getItem('semi-gioco-v2') || '{}').email || ''; } catch {}
    const i = $<HTMLInputElement>('[data-f="entra"] input[name=email]'); if (em && !i.value) i.value = em;
    precompila(fe);
  }
  const fe = $<HTMLFormElement>('[data-f="entra"]');
  fe.addEventListener('submit', async (e) => {
    e.preventDefault();
    const em = (fe.email as HTMLInputElement).value.trim(), b = $<HTMLButtonElement>('button', fe);
    if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(em)) return errore(fe, 'Inserisci un indirizzo email valido.');
    errore(fe, ''); b.disabled = true; b.textContent = 'Invio…'; ricorda(fe);
    try {
      const r = await fetch('/api/account/link', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: em, dopo: dopo || '/account/' }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error);
      fe.hidden = true; $('[data-inviato]').hidden = false; $$('[data-v="entra"] [data-em]').forEach((x) => (x.textContent = em));
    } catch (x: any) { errore(fe, x.message || 'Errore, riprova.'); }
    b.disabled = false; b.textContent = 'Inviami il link';
  });
  $('[data-altra]').addEventListener('click', () => { fe.hidden = false; $('[data-inviato]').hidden = true; (fe.email as HTMLInputElement).focus(); });

  // ---------- registrazione / modifica ----------
  const fp = $<HTMLFormElement>('[data-f="profilo"]');
  capAutomatico(fp);
  const campo = (n: string) => fp.elements.namedItem(n) as HTMLInputElement;
  const tipo = () => ($<HTMLInputElement>('input[name=tipo]:checked')).value;
  const aggiornaTipo = () => {
    $$('[data-solo]', fp).forEach((e) => (e.hidden = e.dataset.solo !== tipo()));
    if (tipo() === 'azienda' && !campo('piva').value) campo('piva').focus();
  };
  $$('input[name=tipo]').forEach((r) => r.addEventListener('change', aggiornaTipo));
  function mostraProfilo(primo: boolean) {
    vedi('profilo');
    const p = me.profilo;
    $$('[data-v="profilo"] [data-em]').forEach((x) => (x.textContent = p.email));
    $('[data-tit]').textContent = primo ? 'Completa il tuo account' : 'Modifica i tuoi dati';
    $('[data-salva]').textContent = primo ? 'Salva e continua' : 'Salva';
    ($<HTMLInputElement>(`input[name=tipo][value="${p.tipo || 'privato'}"]`)).checked = true;
    for (const k of ['nome', 'cognome', 'telefono', 'piva', 'ragioneSociale', 'indirizzo', 'cap', 'citta', 'provincia', 'sdi', 'pec']) if (p[k]) campo(k).value = p[k];
    precompila(fp);
    (campo('offerte')).checked = !!p.offerte;
    if (p.piva) $('[data-az]').hidden = false;
    aggiornaTipo();
    if ((p.tipo || 'privato') === 'privato') campo('nome').focus();
  }
  // partita IVA: alle 11 cifre cerca i dati dell'azienda e compila tutto da solo
  let ultima = '';
  campo('piva').addEventListener('input', async () => {
    const n = campo('piva').value.replace(/\D/g, '');
    const msg = $('[data-piva]');
    if (n.length < 11) { msg.textContent = ''; return; }
    if (n === ultima) return; ultima = n;
    msg.className = 'acc-piva'; msg.textContent = 'Cerco i dati dell\'azienda…';
    try {
      const j = await (await fetch('/api/piva?n=' + n)).json();
      $('[data-az]').hidden = false;
      if (!j.valida) { msg.className = 'acc-piva no'; msg.textContent = 'Questa partita IVA non è valida: controlla le cifre.'; return; }
      if (j.trovata) {
        for (const k of ['ragioneSociale', 'indirizzo', 'cap', 'citta', 'provincia']) if (j[k]) campo(k).value = j[k];
        msg.className = 'acc-piva ok'; msg.innerHTML = `✓ <b>${esc(j.ragioneSociale)}</b> — dati compilati dall'archivio europeo VIES. Controllali e aggiungi il codice SDI se ce l'hai.`;
        campo('sdi').focus();
      } else {
        msg.className = 'acc-piva'; msg.textContent = j.attiva === false ? 'Partita IVA non attiva per le operazioni UE: inserisci i dati a mano.' : 'Non riesco a trovare i dati in automatico: inseriscili a mano.';
        campo('ragioneSociale').focus();
      }
    } catch { msg.textContent = 'Ricerca non disponibile: inserisci i dati a mano.'; $('[data-az]').hidden = false; }
  });
  fp.addEventListener('submit', async (e) => {
    e.preventDefault();
    const b = $<HTMLButtonElement>('[data-salva]'), t = b.textContent;
    const dati: any = { tipo: tipo(), offerte: campo('offerte').checked };
    for (const k of ['nome', 'cognome', 'telefono', 'piva', 'ragioneSociale', 'indirizzo', 'cap', 'citta', 'provincia', 'sdi', 'pec']) dati[k] = campo(k).value.trim();
    errore(fp, ''); b.disabled = true; b.textContent = 'Salvo…'; dimenticaCache();
    try {
      const r = await fetch('/api/account/profilo', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dati) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error);
      if (t === 'Salva e continua') evento('CompleteRegistration', { content_name: dati.tipo === 'azienda' ? 'Account azienda' : 'Account privato', status: true });
      if (dopo && dopo !== '/account/') { location.href = dopo; return; }
      history.replaceState(null, '', '/account/');
      u.searchParams.delete('benvenuto');
      await carica();
    } catch (x: any) { errore(fp, x.message || 'Errore, riprova.'); }
    b.disabled = false; b.textContent = t;
  });

  // ---------- area personale ----------
  function mostraArea() {
    vedi('area');
    const p = me.profilo;
    $('[data-ciao]').textContent = `Ciao ${p.tipo === 'azienda' ? p.ragioneSociale : p.nome}!`;
    $('[data-chi]').textContent = `${p.email} · ${p.tipo === 'azienda' ? 'Partita IVA ' + p.piva : 'Privato'}`;
    $('[data-punti]').textContent = Number(me.punti.saldo || 0).toLocaleString('it-IT');
    mostraLivello(); mostraBuoni();
    if (u.searchParams.has('buono')) setTimeout(() => document.getElementById('buoni')?.scrollIntoView({ behavior: 'smooth' }), 300);
    const sc = me.sconti.filter((s: any) => !s.usato && new Date(s.scade) > new Date());
    $('[data-sconti]').innerHTML = sc.length
      ? sc.map((s: any) => `<p><b class="mono">${esc(s.codice)}</b> · −10% fino al ${data(s.scade)}<br><a class="btn btn-y acc-mini" href="/carrello/?codice=${esc(s.codice)}">Usalo ora</a></p>`).join('')
      : '<p>Nessuno sconto attivo. Gioca a <a class="ul" href="/#gioco">Trapano Slalom</a>: ogni mese puoi vincere il 10%.</p>';
    $('[data-ordini]').innerHTML = me.ordini.length
      ? `<ul class="acc-ord">${me.ordini.map((o: any) => `<li><div><b>Ordine ${esc(o.id)}</b> · ${data(o.quando)}<br><small>${o.righe.map((r: any) => `${r.q}× ${esc(r.nome)}`).join(', ')}</small></div><div class="acc-ord-r"><b>${eur(o.totale)}</b><small>+${o.punti} punti${o.fattura ? ' · fattura' : ''}</small></div></li>`).join('')}</ul>`
      : '<p>Non hai ancora ordini. <a class="ul" href="/catalogo/">Vai al catalogo</a></p>';
    const r = (k: string, v: any) => v ? `<div><span>${k}</span><b>${esc(v)}</b></div>` : '';
    $('[data-dati]').innerHTML = `<div class="acc-dl">${p.tipo === 'azienda'
      ? r('Ragione sociale', p.ragioneSociale) + r('Partita IVA', p.piva) + r('Sede', `${p.indirizzo}, ${p.cap} ${p.citta} ${p.provincia ? '(' + p.provincia + ')' : ''}`) + r('Codice SDI', p.sdi || '0000000') + r('PEC', p.pec)
      : r('Nome', `${p.nome} ${p.cognome}`)}${r('Email', p.email)}${r('Telefono', p.telefono)}${r('Documento', p.tipo === 'azienda' ? 'Fattura elettronica + ricevuta' : 'Ricevuta')}</div>`;
  }
  // ---------- livello, buoni, conversione punti ----------
  function mostraLivello() {
    const l = me.punti.livello, sp = me.punti.spesa || 0;
    const prog = l.prossimo ? Math.min(100, ((sp - l.da) / (l.prossimo.da - l.da)) * 100) : 100;
    $('[data-livello]').innerHTML = `<div class="liv-l">${PX.LIV.map((x: any, i: number) => `<span class="${i <= l.indice ? 'on' : ''}${i === l.indice ? ' cur' : ''}"><b>${esc(x.nome)}</b><small>×${String(x.x).replace('.', ',')} punti</small></span>`).join('')}</div>
      <div class="liv-b"><i style="width:${prog}%"></i></div>
      <p>${l.prossimo ? `Hai speso <b>${eur(sp)}</b> nel programma: ancora <b>${eur(l.manca)}</b> e diventi <b>${esc(l.prossimo.nome)}</b> (×${String(l.prossimo.x).replace('.', ',')} punti su ogni euro).` : `Sei al livello più alto: <b>${esc(l.nome)}</b>, punti doppi su ogni acquisto. 🏆`}</p>`;
  }
  async function mostraBuoni() {
    const j = await (await fetch('/api/buoni/miei', { cache: 'no-store' })).json().catch(() => ({ buoni: [] }));
    const l = j.buoni || [];
    $('[data-buoni]').innerHTML = l.length ? `<ul class="acc-bu">${l.map((b: any) => `<li class="${b.disponibile > 0 ? '' : 'off'}"><span class="bu-t ${b.soloPremi ? 'p' : 'r'}">${b.soloPremi ? 'Buono punti' : 'Buono regalo'}</span><span class="mono">…${esc(b.fine)}</span><b>${eur(b.disponibile)}</b><small>${b.disponibile > 0 ? (b.soloPremi ? 'sui prodotti del Catalogo Premi' : 'su tutto il sito') : 'speso'}${b.importo !== b.disponibile && b.disponibile > 0 ? ` · su ${eur(b.importo)}` : ''}</small></li>`).join('')}</ul><p class="acc-note">Si applicano da soli nel carrello. Nessuna scadenza.</p>` : '<p>Nessun buono per ora.</p>';
    const ac = j.acquistati || [];
    $('[data-acquistati]').innerHTML = ac.length ? `<h3>Buoni regalo che hai comprato</h3><ul class="acc-bu">${ac.map((b: any) => `<li class="${b.stato === 'annullato' ? 'off' : ''}"><span class="bu-t r">${b.destinatario ? 'Per ' + esc(b.destinatario) : 'Per te'}</span><span class="mono">…${esc(b.fine)}</span><b>${eur(b.importo)}</b><small>${b.stato === 'annullato' ? 'rimborsato' : b.disponibile < b.importo ? `usato in parte · restano ${eur(b.disponibile)}` : 'non ancora usato'} · ${data(b.creato)}${b.rimborsabile ? ` · <button type="button" class="lnk" data-rimb="${b.id}">Recesso: rimborsa</button>` : ''}</small></li>`).join('')}</ul>` : '';
    const aperto = Date.now() >= new Date(PX.catalogo + 'T00:00:00+01:00').getTime();
    const saldo = me.punti.saldo || 0;
    $('[data-converti]').innerHTML = `<h3>Converti i punti in buoni</h3>${aperto ? '' : `<p class="acc-note">Dal <b>25 dicembre</b> con il Catalogo Premi 2027. Intanto accumula: più punti converti insieme, più valgono.</p>`}
      <div class="conv">${PX.CONV.map((c: any) => `<button type="button" class="conv-b" data-c="${c.punti}" ${aperto && saldo >= c.punti ? '' : 'disabled'}><b>${eur(c.euro * 100)}</b><span>${c.punti.toLocaleString('it-IT')} punti</span></button>`).join('')}</div>`;
  }
  $('[data-converti]').addEventListener('click', async (e) => {
    const t = (e.target as HTMLElement).closest('[data-c]') as HTMLButtonElement; if (!t || t.disabled) return;
    const c = PX.CONV.find((x: any) => x.punti === Number(t.dataset.c));
    if (!confirm(`Convertire ${c.punti} punti in un buono da ${c.euro} € sui prodotti del Catalogo Premi?`)) return;
    t.disabled = true;
    const r = await fetch('/api/buoni/converti', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ punti: c.punti }) });
    const j = await r.json();
    if (!r.ok) { alert(j.error || 'Errore'); t.disabled = false; return; }
    await carica();
  });
  $('[data-acquistati]').addEventListener('click', async (e) => {
    const t = (e.target as HTMLElement).closest('[data-rimb]') as HTMLButtonElement; if (!t) return;
    if (!confirm('Vuoi annullare questo buono e ricevere il rimborso sul metodo di pagamento usato? Il codice non sarà più valido.')) return;
    t.disabled = true;
    const r = await fetch('/api/buoni/rimborso', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: t.dataset.rimb }) });
    const j = await r.json();
    alert(r.ok ? 'Rimborso avviato: arriva in 5–10 giorni lavorativi. Ti abbiamo mandato una conferma via email.' : (j.error || 'Errore'));
    await mostraBuoni();
  });
  const fa = $<HTMLFormElement>('[data-f="aggiungi"]');
  fa.addEventListener('submit', async (e) => {
    e.preventDefault();
    const b = $<HTMLButtonElement>('button', fa), c = (fa.codice as HTMLInputElement).value.trim();
    if (!c) return;
    errore(fa, ''); b.disabled = true;
    try {
      const r = await fetch('/api/buoni/aggiungi', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ codice: c }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error);
      (fa.codice as HTMLInputElement).value = ''; await mostraBuoni();
    } catch (x: any) { errore(fa, x.message || 'Errore'); }
    b.disabled = false;
  });
  $('[data-modifica]').addEventListener('click', () => mostraProfilo(false));
  $('[data-esci]').addEventListener('click', async () => { await fetch('/api/account/esci', { method: 'POST' }); location.href = '/'; });
  $('[data-elimina]').addEventListener('click', async () => {
    if (!confirm('Vuoi eliminare il tuo account? Perderai punti e sconti. Gli ordini restano registrati solo per gli obblighi fiscali.')) return;
    const r = await fetch('/api/account/elimina', { method: 'POST' });
    if (r.ok) location.href = '/'; else alert('Non è stato possibile eliminare l\'account ora. Scrivici a info@semistore.it.');
  });

  carica();
</script>
