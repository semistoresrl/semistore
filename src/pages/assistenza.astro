---
import Base from '../layouts/Base.astro';
import { SITO } from '../data/sito.js';
const FAQ = [
  ['Siete un centro assistenza autorizzato DEWALT?', 'Sì. SE.M.I. srl è concessionario DEWALT per Lazio, Campania e Molise e centro assistenza autorizzato: ripariamo in sede elettroutensili DEWALT, STANLEY e BLACK+DECKER e gestiamo direttamente le pratiche di garanzia con il produttore.'],
  ['La riparazione in garanzia è gratuita?', 'Sì, se il guasto è coperto dalla garanzia del produttore. Porta l\'utensile con lo scontrino o la fattura d\'acquisto: verifichiamo noi la copertura e apriamo la pratica.'],
  ['Quanto costa riparare un utensile fuori garanzia?', 'Dipende dal guasto e dai ricambi. Facciamo prima la diagnosi e ti mandiamo un preventivo: ripariamo solo dopo la tua approvazione.'],
  ['Quanto tempo serve per la riparazione?', 'Con i ricambi disponibili bastano pochi giorni lavorativi. Se un ricambio va ordinato a DEWALT ti avvisiamo dei tempi; lo stato si segue online con il numero di scheda.'],
  ['Posso spedire l\'utensile invece di portarlo?', 'Sì. Apri la richiesta online e scegli “Lo spedisco io” (spese a tuo carico) oppure “Venite a ritirarlo voi”: prenotiamo noi il corriere e il ritiro si paga dopo, insieme alla riparazione. In entrambi i casi ricevi subito il DDT da stampare e mettere nel pacco.'],
  ['Da quali zone arrivano i clienti?', 'Da Napoli e da tutta la provincia: Casavatore, Casoria, Arzano, Afragola, Secondigliano, Frattamaggiore, Caivano, Acerra e dintorni. Chi è lontano può spedire.'],
  ['Vendete anche ricambi originali?', 'Sì: ricambi originali DEWALT, STANLEY e BLACK+DECKER, anche su ordinazione. Chiedi al banco o scrivici il modello e il Type dell\'utensile.'],
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Riparazione elettroutensili DEWALT, STANLEY e BLACK+DECKER', serviceType: 'Centro assistenza autorizzato elettroutensili', provider: { '@id': SITO.url + '/#negozio' }, areaServed: ['Napoli', 'Casavatore', 'Casoria', 'Arzano', 'Afragola', 'Italia'], url: SITO.url + '/assistenza/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
const STATI = ['Ricevuto', 'In diagnosi', 'Preventivo inviato', 'Attesa ricambi', 'In riparazione', 'Pronto', 'Consegnato'];
---
<Base image="/og/assistenza.jpg" title="Concessionario DEWALT Lazio, Campania, Molise: centro assistenza e riparazioni" description={`Centro assistenza autorizzato DEWALT, STANLEY e BLACK+DECKER a Casavatore (Napoli): riparazioni in garanzia e fuori garanzia, preventivo prima dell'intervento, ricambi originali. Richiedi assistenza online.`} jsonld={ld}>
  <section class="hero-a"><div class="wrap">
    <span class="kicker" style="color:var(--y)">{SITO.concessionario} · Centro assistenza autorizzato</span>
    <h1>Assistenza e riparazioni</h1>
    <p>Apri la richiesta online, portaci l'utensile e segui la riparazione passo passo.</p>
  </div></section>

  <div class="wrap ag">
    <form id="req" class="card box" novalidate>
      <h2 id="preventivo">Richiedi assistenza o preventivo</h2>
      <fieldset class="step" data-step="1">
        <legend>1 · L'utensile</legend>
        <label class="field">Modello / codice (sull'etichetta)<input name="modello" required placeholder="es. DCD805" /></label>
        <label class="field">Numero di serie (se lo trovi)<input name="seriale" /></label>
        <label class="field">È in garanzia?<select name="garanzia"><option>Non so</option><option>Sì, ho lo scontrino/fattura</option><option>No</option></select></label>
        <label class="field">Che problema ha?<textarea name="problema" required placeholder="es. non si avvia, fa scintille, batteria non carica…"></textarea></label>
      </fieldset>
      <fieldset class="step" data-step="2">
        <legend>2 · I tuoi dati</legend>
        <label class="field">Nome e cognome / ditta<input name="nome" required autocomplete="name" /></label>
        <label class="field">Telefono<input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" /></label>
        <label class="field">Email<input name="email" type="email" autocomplete="email" /></label>
      </fieldset>
      <fieldset class="step" data-step="3">
        <legend>3 · Come ci arriva l'utensile</legend>
        <label class="radio opt"><input type="radio" name="consegna" value="negozio" checked /><span><b>Lo porto in negozio</b><small>{SITO.indirizzo}, {SITO.citta} · {SITO.orari[0].giorni} {SITO.orari[0].ore}</small></span></label>
        <label class="radio opt"><input type="radio" name="consegna" value="spedisco" /><span><b>Lo spedisco io</b><small>Con il corriere che preferisci, spese di spedizione a tuo carico. Ti diamo subito il DDT da mettere nel pacco.</small></span></label>
        <label class="radio opt"><input type="radio" name="consegna" value="ritiro" /><span><b>Venite a ritirarlo voi</b><small>Prenotiamo noi il corriere: il costo del ritiro si paga dopo, insieme alla riparazione. Ti diamo subito il DDT da mettere nel pacco.</small></span></label>
        <div id="pacco" class="pacco" hidden>
          <p class="nota">Indirizzo da cui parte il pacco (va anche sul DDT)</p>
          <label class="field">Indirizzo e numero civico<input name="indirizzo" autocomplete="street-address" /></label>
          <div class="riga3">
            <label class="field">CAP<input name="cap" inputmode="numeric" maxlength="5" autocomplete="postal-code" /></label>
            <label class="field">Città<input name="citta" autocomplete="address-level2" /></label>
            <label class="field">Prov.<input name="prov" maxlength="2" style="text-transform:uppercase" /></label>
          </div>
          <label class="field">Codice fiscale o Partita IVA (per il DDT, facoltativo)<input name="cf" style="text-transform:uppercase" /></label>
          <div class="riga2">
            <label class="field">Numero di colli<input name="colli" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
            <label class="field">Accessori nel pacco<input name="accessori" placeholder="es. 2 batterie, caricatore, valigetta" /></label>
          </div>
          <label class="field" id="dispo" hidden>Quando possiamo passare a ritirarlo?<input name="disponibilita" placeholder="es. lun–ven 9–13, citofono Rossi" /></label>
          <p class="nota">Imballa bene l'utensile (meglio nella sua valigetta, dentro una scatola) e metti nel pacco il DDT stampato. Se non puoi stampare, scrivi sul pacco il numero della richiesta.</p>
        </div>
        <label class="radio chk"><input type="checkbox" name="privacy" required /> Ho letto l'<a class="ul" href="/privacy/">informativa privacy</a>: i dati servono solo a gestire la richiesta</label>
        <input type="text" name="sito_web" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      </fieldset>
      <button class="btn btn-y" id="inv">Invia richiesta</button>
      <p id="msg" role="status" class="msg" hidden></p>
    </form>

    <div class="col-a">
      <form id="stato" class="card box">
        <h2>Stato della riparazione</h2>
        <label class="field">Numero scheda<input name="scheda" required class="mono" placeholder="es. AS-2026-0142 o WEB-…" /></label>
        <label class="field">Telefono lasciato in accettazione<input name="tel" type="tel" required inputmode="tel" /></label>
        <button class="btn btn-k">Controlla</button>
        <div id="esito" aria-live="polite"></div>
      </form>
      <div class="card box">
        <h2>Preferisci parlarne?</h2>
        <p style="margin:0">Chiamaci al <a class="ul" href={`tel:${SITO.telefonoLink}`}>{SITO.telefono}</a> o scrivi a <a class="ul" href={`mailto:${SITO.email}`}>{SITO.email}</a>.</p>
      </div>
    </div>
  </div>
  <section class="wrap sec prose ass-faq">
    <h2>Centro assistenza DEWALT a Napoli</h2>
    <p>SE.M.I. srl, attiva dal 1997 a Casavatore, al confine con Napoli nord, è concessionario DEWALT, STANLEY e BLACK+DECKER per Lazio, Campania e Molise e centro assistenza autorizzato DEWALT. Ripariamo trapani, avvitatori, tassellatori, smerigliatrici, seghe, troncatrici, utensili da giardino, batterie e caricabatterie DEWALT, STANLEY e BLACK+DECKER, con ricambi originali e pratiche di garanzia gestite in sede.</p>
    <h2>Domande frequenti</h2>
    {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>
</Base>
<script define:vars={{ STATI }}>window.__STATI = STATI;</script>
<script>
  const STATI: string[] = (window as any).__STATI;
  const f = document.getElementById('req') as HTMLFormElement, msg = document.getElementById('msg')!;
  const pacco = document.getElementById('pacco')!, dispo = document.getElementById('dispo')!;
  const pac = () => { const v = (f.elements.namedItem('consegna') as RadioNodeList).value; const on = v !== 'negozio'; pacco.hidden = !on; dispo.hidden = v !== 'ritiro';
    ['indirizzo', 'cap', 'citta', 'prov'].forEach((n) => ((f.elements.namedItem(n) as HTMLInputElement).required = on)); };
  f.querySelectorAll('input[name=consegna]').forEach((r) => r.addEventListener('change', pac)); pac();
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!f.checkValidity()) { f.reportValidity(); return; }
    const b = document.getElementById('inv') as HTMLButtonElement; b.disabled = true; b.textContent = 'Invio…';
    try {
      const r = await fetch('/api/assistenza', { method: 'POST', body: new FormData(f) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error || 'errore');
      if (j.ddt) { location.href = j.ddt; return; }
      f.reset(); pac(); msg.className = 'msg ok'; msg.textContent = `Richiesta ricevuta (n. ${j.id}). Ti richiamiamo entro un giorno lavorativo.`;
    } catch { msg.className = 'msg ko'; msg.textContent = 'Invio non riuscito. Riprova o chiamaci.'; }
    msg.hidden = false; b.disabled = false; b.textContent = 'Invia richiesta';
  });
  const s = document.getElementById('stato') as HTMLFormElement, out = document.getElementById('esito')!;
  async function check() {
    const d = new FormData(s); if (!d.get('scheda') || !d.get('tel')) return;
    out.textContent = 'Controllo…';
    try {
      const r = await fetch('/api/stato?' + new URLSearchParams({ scheda: String(d.get('scheda')), tel: String(d.get('tel')) }));
      const j = await r.json(); if (!r.ok) throw new Error(j.error);
      const i = STATI.indexOf(j.stato);
      out.innerHTML = `<div class="bar">${STATI.map((_, k) => `<span class="${k <= i ? 'on' : ''}"></span>`).join('')}</div><p><b></b></p><p class="nota"></p>`;
      out.querySelector('b')!.textContent = j.stato; out.querySelector('.nota')!.textContent = j.nota || '';
    } catch (e: any) { out.textContent = e.message === 'non trovata' ? 'Scheda non trovata: controlla numero e telefono.' : 'Servizio non disponibile, chiamaci.'; }
  }
  s.addEventListener('submit', (e) => { e.preventDefault(); check(); });
  const u = new URL(location.href);
  if (u.searchParams.get('scheda')) { (s.elements.namedItem('scheda') as HTMLInputElement).value = u.searchParams.get('scheda')!; (s.elements.namedItem('tel') as HTMLInputElement).value = u.searchParams.get('tel') || ''; check(); }
</script>
<style is:global>
  .hero-a{background:var(--ink);color:#fff;padding:48px 0}.hero-a h1{font-size:clamp(34px,5vw,56px);text-transform:uppercase;margin:12px 0}.hero-a p{color:#c9cbcf;margin:0;font-size:18px}
  .ag{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(min(280px,100%),1fr);gap:20px;padding-top:32px;align-items:start}
  @media (max-width:860px){.ag{grid-template-columns:1fr}}
  .col-a{display:flex;flex-direction:column;gap:20px}
  .box{padding:clamp(16px,5vw,24px);display:flex;flex-direction:column;gap:16px}.box h2{font-size:24px}
  .step{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}.step legend{font-weight:900;font-size:16px;margin-bottom:8px;color:var(--y-d)}
  .radio{display:flex;gap:10px;align-items:center;min-height:40px}.chk{font-size:14px}
  .opt{align-items:flex-start;border:2px solid var(--line);border-radius:14px;padding:12px;cursor:pointer}.opt:has(input:checked){border-color:var(--ink);background:#fffbea}.opt input{margin-top:4px}.opt span{display:flex;flex-direction:column;gap:2px}.opt small{color:var(--mut);font-size:14px;line-height:1.4}
  .pacco{display:flex;flex-direction:column;gap:12px;background:#f6f5f2;border-radius:14px;padding:14px}.pacco[hidden]{display:none}
  .riga3{display:grid;grid-template-columns:90px 1fr 70px;gap:10px}.riga2{display:grid;grid-template-columns:110px 1fr;gap:10px}
  .hp{position:absolute;left:-9999px}
  .msg{margin:0;font-weight:700}.msg.ok{color:var(--ok)}.msg.ko{color:#b3261e}
  .bar{display:flex;gap:4px;margin-top:4px}.bar span{flex:1;height:8px;border-radius:4px;background:var(--line)}.bar span.on{background:var(--ink)}
  .nota{color:var(--mut);margin:0}
</style>
<style>.ass-faq details{border-bottom:1px solid var(--line);padding:12px 0}.ass-faq summary{font-weight:700;cursor:pointer}.ass-faq details p{margin:8px 0 0}</style>
