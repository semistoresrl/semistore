---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import prodotti from '../data/prodotti.json';
import { SITO, euro } from '../data/sito.js';
import { fotoDi } from '../data/foto';
import OffertaFlash from '../components/OffertaFlash.astro';
import VideoNegozio from '../components/VideoNegozio.astro';
import RecensioniGoogle from '../components/RecensioniGoogle.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { urlCategoria } from '../data/catalogo';

const evidenza = ['DCD805P2T', 'DCF850P2T', 'DCG405P2', 'DCF900P2T', 'DCH273P2T', 'DCK2050E2T', 'DCS438E2T', 'DCE089D1G']
  .map((m) => prodotti.find((p) => p.modello === m)).filter(Boolean).slice(0, 8);
const cats = Object.entries(prodotti.reduce((a, p) => ((a[p.categoria] = (a[p.categoria] || 0) + 1), a), {} as Record<string, number>))
  .sort((a, b) => b[1] - a[1]);
const sigla: Record<string, string> = { 'Trapani e avvitatori': 'TR', 'Tassellatori e demolitori': 'TS', 'Smerigliatrici e levigatrici': 'SM', 'Seghe e troncatrici': 'SG', 'Batterie e caricabatterie': 'BT', 'Kit': 'KT', 'Misura e laser': 'MI', 'Contenitori e organizzazione': 'ST', 'Giardino': 'GI', 'Altri utensili': 'AU', 'Punte e inserti': 'PI', 'Lame, dischi e abrasivi': 'LD', 'Chiodatrici e fissaggio': 'CH', 'Accessori per elettroutensili': 'AC', 'Aspirazione e pulizia': 'AS', 'Utensili manuali': 'UM', 'Compressori e aria compressa': 'CO' };
// Anteprime animate delle categorie: 4 foto ufficiali che si alternano con un leggero zoom
const anteprima = (c: string) => {
  const foto = prodotti.filter((p) => p.categoria === c).map((p) => fotoDi(p.slug, 400) || (p.kit ? p.kit.find((k: any) => k.u)?.u : undefined)).filter(Boolean) as string[];
  const uniche = [...new Set(foto)].slice(0, 4);
  if (!uniche.length) return [];
  while (uniche.length < 4) uniche.push(uniche[uniche.length % Math.max(1, uniche.length)]);
  return uniche;
};
const slugCat = (c: string) => c.toLowerCase().split(/[ ,]/)[0];
const piattaforme = [
  { v: '12V', n: 'XR 12V', d: 'Compatti e leggeri, per installatori e spazi stretti.', q: '12v' },
  { v: '18V', n: 'XR 18V', d: 'La gamma più ampia: il sistema di riferimento per il professionista.', q: '18v' },
  { v: '54V', n: 'FLEXVOLT', d: 'Potenza da cavo per seghe, troncatrici e lavori pesanti.', q: '54v' },
];
const passi = [
  ['Apri la richiesta', 'Online in 2 minuti, o direttamente al banco.'],
  ['Porta o spedisci', 'Ti diamo il numero di scheda da seguire.'],
  ['Diagnosi e preventivo', 'In garanzia non paghi; fuori garanzia approvi prima.'],
  ['Ritira', 'Ti avvisiamo appena è pronto.'],
];
const popolari = ['DCB184', 'DCD796P2', 'DCF887P2', 'DCH172E2T', 'DCG418T2', 'DCD706D2', 'DWST1-70706', 'DCB118']
  .map((m) => prodotti.find((p) => p.modello === m)).filter(Boolean);
// Foto della categoria: il prodotto più "importante" (prezzo più alto) con foto propria
// Foto rappresentativa scelta a mano per ogni categoria (se manca: il prodotto più caro con foto)
const fotoScelta: Record<string, string> = { 'Trapani e avvitatori': 'DCD805P2T', 'Smerigliatrici e levigatrici': 'DCG405P2', 'Tassellatori e demolitori': 'DCH273P2T', 'Seghe e troncatrici': 'DCS573NT', 'Batterie e caricabatterie': 'DCB184', 'Misura e laser': 'DCE089D1G', 'Chiodatrici e fissaggio': 'DCN890P2', 'Contenitori e organizzazione': 'DWST1-70706', 'Giardino': 'DCMST561P1', 'Aspirazione e pulizia': 'DCV586MT2', 'Punte e inserti': 'DT9536', 'Lame, dischi e abrasivi': 'DT1945', 'Utensili manuali': 'DWMT81610-0', 'Accessori per elettroutensili': 'DWS5022', 'Kit': 'DCK685P3T', 'Altri utensili': 'DCS356P2' };
const fotoCat = (c: string) => {
  const m = prodotti.find((x) => x.modello === fotoScelta[c] && fotoDi(x.slug, 400));
  if (m) return fotoDi(m.slug, 400);
  const p = prodotti.filter((x) => x.categoria === c && fotoDi(x.slug, 400)).sort((a, b) => b.prezzo - a.prezzo)[0];
  return p ? fotoDi(p.slug, 400) : anteprima(c)[0];
};
const ordineCat = ['Trapani e avvitatori', 'Smerigliatrici e levigatrici', 'Tassellatori e demolitori', 'Seghe e troncatrici', 'Batterie e caricabatterie', 'Misura e laser', 'Chiodatrici e fissaggio', 'Contenitori e organizzazione', 'Giardino', 'Aspirazione e pulizia', 'Punte e inserti', 'Lame, dischi e abrasivi', 'Utensili manuali', 'Accessori per elettroutensili', 'Compressori e aria compressa', 'Kit', 'Altri utensili'];
const catOrd = ordineCat.filter((c) => cats.some(([x]) => x === c)).concat(cats.map(([c]) => c).filter((c) => !ordineCat.includes(c)));
const nCat = Object.fromEntries(cats);
// 4 foto per categoria che si alternano (la prima è quella scelta), come nella versione precedente
const fotoAnim = (c: string) => {
  const prima = fotoCat(c);
  const altre = prodotti.filter((x) => x.categoria === c && fotoDi(x.slug, 400)).sort((a, b) => b.prezzo - a.prezzo).map((x) => fotoDi(x.slug, 400) as string);
  const uniche = [...new Set([prima, ...altre].filter(Boolean))].slice(0, 4) as string[];
  while (uniche.length && uniche.length < 4) uniche.push(uniche[uniche.length % uniche.length]);
  return uniche;
};
const fotoVolt = (v: string, m: string) => { const p = prodotti.find((x) => x.modello === m); return p ? fotoDi(p.slug, 400) : undefined; };
const piattaformeF = [
  { ...piattaforme[0], img: fotoVolt('12V', 'DCE089D1G') },
  { ...piattaforme[1], img: fotoVolt('18V', 'DCB184') },
  { ...piattaforme[2], img: fotoVolt('54V', 'DCB118') },
];
const marchi = [['DEWALT', 'dewalt'], ['STANLEY', 'stanley'], ['BLACK+DECKER', 'blackdecker'], ['USAG', 'usag'], ['LENOX', 'lenox']].map(([n, q]) => [n, q, prodotti.filter((p) => p.marca === n).length]);
const vantaggi = [
  ['Centro autorizzato', 'Riparazioni e garanzie DEWALT in sede', '/assistenza/', '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>'],
  ['Spedizione gratis', `Sopra ${euro(SITO.spedizione.gratisDa).replace(',00', '')} · ${SITO.spedizione.giorni} giorni`, '/condizioni-di-vendita/', '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>'],
  ['Sotto listino', 'Prezzi scontati sul listino ufficiale', '/catalogo/', '<path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/>'],
  ['Parla con noi', `Tel. ${SITO.telefono}`, `tel:${SITO.telefonoLink}`, '<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/>'],
];
---
<Base title={SITO.nome}>
  <HeroSlider />

  <section class="vt"><div class="wrap">
    <div class="vt-g">
      {vantaggi.map(([t, d, h, ic]) => (
        <a class="vt-i" href={h}>
          <span class="vt-ic"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic}></svg></span>
          <span class="vt-t"><b>{t}</b><small>{d}</small></span>
        </a>
      ))}
    </div>
    <a class="vt-rev" href="#recensioni" hidden data-voto>
      <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
      <b data-voto-v></b><span class="vt-st" aria-hidden="true">★★★★★</span><span class="vt-n" data-voto-n></span><span class="vt-ar" aria-hidden="true">→</span>
    </a>
  </div></section>

  <OffertaFlash />

  <section class="sec"><div class="wrap">
    <div class="sec-h"><h2 class="h2">Categorie più popolari</h2><a href="/catalogo/" class="ul">Scopri tutte le categorie</a></div>
    <div class="ct">
      {catOrd.map((c, i) => (
        <a href={urlCategoria(c)} class="ct-c" style={`--d:${(i * 1.3) % 8}s`}>
          <span class="ct-i">{fotoAnim(c).length ? fotoAnim(c).map((u, k) => <img src={u} alt="" width="400" height="400" loading="lazy" decoding="async" style={`animation-delay:calc(${k * 2}s - var(--d))`} />) : <span class="mono">{sigla[c] || 'AU'}</span>}</span>
          <b>{c}</b><small>{nCat[c]} articoli</small>
        </a>
      ))}
      <a href="/catalogo/" class="ct-c ct-all"><span class="ct-i"><span>→</span></span><b>Tutto il catalogo</b><small>{prodotti.length} articoli</small></a>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="sec-h"><h2 class="h2">Prodotti consigliati</h2>
      <span class="rc-nav"><button type="button" class="rc-b" data-rc="-1" aria-label="Indietro">‹</button><button type="button" class="rc-b" data-rc="1" aria-label="Avanti">›</button></span>
    </div>
    <div class="rc" id="rc">{evidenza.map((p) => <ProductCard p={p} />)}</div>
  </div></section>

  <section class="wrap bn">
    <a class="bn-a" href="/assistenza/">
      <span class="bn-st" aria-hidden="true">
        <img src="/img/hero/dch273nt-400.webp" alt="" loading="lazy" decoding="async" style="left:4%;top:6%;width:46%;--r:-8deg" />
        <img src="/img/hero/dcg405nt-400.webp" alt="" loading="lazy" decoding="async" style="left:44%;top:30%;width:54%;--r:6deg" />
      </span>
      <span class="bn-t">
        <b>Utensile fermo? Lo rimettiamo in piedi</b>
        <span>Diagnosi in laboratorio, ricambi originali e preventivo prima di riparare. In garanzia non paghi.</span>
        <span class="btn btn-k">Richiedi assistenza</span>
      </span>
    </a>
    <div class="bn-p">
      <div class="bn-pg">
        {piattaformeF.map((p) => (
          <a href={`/catalogo/?volt=${p.q}`} class="bn-pc">
            {p.img && <img src={p.img} alt="" width="400" height="400" loading="lazy" decoding="async" />}
            <span class="bn-v">{p.v}</span><span class="bn-n">{p.n}</span>
          </a>
        ))}
      </div>
      <span class="bn-pt"><b>12V, 18V o 54V?</b><span>Una batteria, decine di utensili: scegli la tua piattaforma.</span></span>
    </div>
  </section>


  <section class="sec"><div class="wrap">
    <div class="sec-h"><h2 class="h2">Prodotti più popolari</h2><a href="/catalogo/" class="ul">Vai al catalogo</a></div>
    <div class="grid-p">{popolari.map((p) => <ProductCard p={p} />)}</div>
  </div></section>

  <section class="wrap mr">
    <h2 class="mr-h">I nostri marchi</h2>
    <div class="mr-g">
      {marchi.map(([n, q, k]) => <a href={`/catalogo/?marca=${q}`} class={`mr-c mr-${q}`}><b>{n}</b><small>{k} prodotti</small></a>)}
    </div>
  </section>

  <VideoNegozio />
  <RecensioniGoogle />

  <section class="ass"><div class="wrap ass-in">
    <div class="ass-t">
      <span class="kicker">Centro assistenza autorizzato</span>
      <h2>Utensile fermo?<br />Lo rimettiamo in piedi.</h2>
      <div class="steps">{passi.map(([t, d], i) => <div class="step"><span class="mono">0{i + 1}</span><b>{t}</b><span>{d}</span></div>)}</div>
      <a href="/assistenza/" class="btn btn-k" style="align-self:flex-start">Richiedi assistenza online</a>
    </div>
    <form class="card ass-f" action="/assistenza/" method="get">
      <b style="font-size:22px">Segui la tua riparazione</b>
      <span style="color:var(--mut);font-size:14px">Inserisci il numero di scheda che ti abbiamo dato al banco e il tuo telefono.</span>
      <label class="field">Numero scheda<input name="scheda" required placeholder="es. AS-2026-0142" class="mono" /></label>
      <label class="field">Telefono<input name="tel" type="tel" required inputmode="tel" autocomplete="tel" /></label>
      <button class="btn btn-y" formaction="/assistenza/#stato">Controlla lo stato</button>
    </form>
  </div></section>
</Base>

<style>
  .ass{background:var(--y)}.ass-in{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:40px;align-items:center;padding-top:64px;padding-bottom:64px}
  .ass-t{display:flex;flex-direction:column;gap:20px}.ass-t h2{font-size:clamp(28px,5vw,52px);text-transform:uppercase;line-height:.95}
  .steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .step{background:var(--ink);color:#fff;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:4px}.step .mono{color:var(--y);font-weight:700}.step span:last-child{font-size:13px;color:var(--mut-d)}
  @media (max-width:360px){.steps{grid-template-columns:1fr}}
  .ass-f{padding:clamp(18px,5vw,28px);display:flex;flex-direction:column;gap:14px;box-shadow:0 24px 50px #0002}

  .vt{background:#fff;border-bottom:1px solid var(--line)}
  .vt .wrap{display:flex;flex-direction:column;gap:12px;padding-top:18px;padding-bottom:18px}
  .vt-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  .vt-i{display:flex;gap:12px;align-items:center;background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:12px 14px;transition:border-color .15s,transform .15s}
  .vt-i:hover{color:inherit;border-color:var(--y);transform:translateY(-1px)}
  .vt-ic{flex:0 0 42px;height:42px;border-radius:50%;background:var(--y);color:var(--ink);display:grid;place-items:center}
  .vt-t{min-width:0;display:flex;flex-direction:column;line-height:1.2}.vt-t b{font-size:15px}.vt-t small{color:var(--mut);font-size:13px;margin-top:2px}
  .vt-rev{align-self:center;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:14px}
  .vt-rev[hidden]{display:none}.vt-rev:hover{color:inherit;border-color:var(--y)}
  .vt-rev b{font-size:16px}.vt-st{color:#f5b400;letter-spacing:1px}.vt-n{color:var(--mut)}.vt-ar{font-weight:800}
  @media (max-width:900px){.vt-g{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:420px){.vt-i{flex-direction:column;align-items:flex-start;gap:8px;padding:12px}.vt-ic{flex-basis:auto;width:38px;height:38px}.vt-t b{font-size:14.5px}.vt-t small{font-size:12.5px}}
  .ct{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
  .ct-c{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px 10px 16px;transition:transform .15s,box-shadow .15s}
  .ct-c:hover{color:inherit;transform:translateY(-2px);box-shadow:0 12px 26px #0001;border-color:var(--y)}
  .ct-i{position:relative;width:100%;aspect-ratio:1;display:grid;place-items:center;margin-bottom:6px;overflow:hidden}
  .ct-i img{position:absolute;inset:7%;width:86%;height:86%;object-fit:contain;opacity:0;animation:catv 8s infinite linear;will-change:opacity,transform}
  .ct-i img:first-child{opacity:1}
  .ct-c:not(.ct-all) .ct-i::after{content:'';position:absolute;left:10%;right:10%;bottom:0;height:3px;border-radius:2px;background:var(--y);transform-origin:left;animation:catbar 2s infinite linear;animation-delay:calc(0s - var(--d))}
  @keyframes catv{0%{opacity:0;transform:scale(1.25) translateX(8%)}4%{opacity:1}25%{opacity:1;transform:scale(1) translateX(-6%)}29%{opacity:0;transform:scale(.95) translateX(-10%)}100%{opacity:0}}
  @keyframes catbar{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes catfade{0%{opacity:0}4%{opacity:1}25%{opacity:1}29%{opacity:0}100%{opacity:0}}
  @media (prefers-reduced-motion:reduce){.ct-i img{animation-name:catfade}.ct-i::after{display:none}}
  .ct-i>span{font-size:22px;font-weight:800;color:#c9c6bc}
  .ct-c b{font-size:15px;line-height:1.2}.ct-c small{font-size:12px;color:var(--mut);font-weight:600}
  .ct-all{background:var(--ink);color:#fff;border-color:var(--ink)}.ct-all:hover{color:#fff}.ct-all .ct-i>span{width:64px;height:64px;border-radius:50%;background:var(--y);color:var(--ink);display:grid;place-items:center;font-size:30px}.ct-all small{color:var(--mut-d)}
  @media (max-width:560px){.ct-c:nth-child(n+9):not(.ct-all){display:none}.ct{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.ct-c{padding:8px 6px 12px;border-radius:12px}.ct-c b{font-size:12.5px}.ct-c small{font-size:11px}}
  .bn{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:16px;padding-top:8px}
  .bn-a{position:relative;border-radius:20px;overflow:hidden;min-height:420px;display:flex;flex-direction:column;justify-content:flex-end;color:var(--ink);background:var(--y);isolation:isolate}.bn-a:hover{color:var(--ink)}
  .bn-a::after{content:'';position:absolute;inset:0;z-index:-2;background:repeating-linear-gradient(-45deg,#0000 0 24px,#0000000b 24px 48px)}
  .bn-st{position:relative;display:block;width:100%;aspect-ratio:1.7/1;max-width:520px;align-self:center;margin-top:16px}.bn-st img{position:absolute;transform:rotate(var(--r));filter:drop-shadow(0 16px 18px #0006);transition:transform .4s}.bn-a:hover .bn-st img{transform:rotate(var(--r)) scale(1.04)}
  .bn-t{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;padding:24px;width:100%}
  .bn-t b{font-size:clamp(24px,3vw,32px);line-height:1.05;font-weight:900;text-transform:uppercase}.bn-t>span:not(.btn){color:#2b2d31;max-width:440px}
  .bn-t .btn{width:min(100%,360px);margin-top:4px}
  .bn-p{border-radius:20px;overflow:hidden;background:var(--ink);display:flex;flex-direction:column;min-height:340px}
  .bn-pg{flex:1;display:grid;grid-template-columns:repeat(3,1fr)}
  .bn-pc{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:20px 8px;color:#fff;border-right:1px solid #ffffff14}.bn-pc:last-child{border:0}
  .bn-pc:nth-child(1){background:#1d2024}.bn-pc:nth-child(2){background:#23262b}.bn-pc:nth-child(3){background:#2a2e34}
  .bn-pc:hover{color:var(--y)}
  .bn-pc img{width:min(100%,140px);aspect-ratio:1;object-fit:contain;background:#fff;border-radius:14px;padding:8px;margin-bottom:10px}
  .bn-v{font-size:clamp(30px,4vw,44px);font-weight:900;color:var(--y);line-height:1}.bn-n{font-size:13px;color:var(--mut-d);font-weight:700}
  .bn-pt{display:flex;flex-direction:column;align-items:center;text-align:center;padding:18px 20px 24px;color:#fff;gap:4px}.bn-pt b{font-size:clamp(24px,3vw,32px);font-weight:900}.bn-pt span{color:var(--mut-d)}
  .rc-nav{display:flex;gap:8px}.rc-b{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:#fff;font-size:24px;line-height:1;cursor:pointer;color:var(--ink)}.rc-b:hover{border-color:var(--y)}
  .rc{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(230px,calc((100% - 36px)/4));gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding-bottom:6px}
  .rc::-webkit-scrollbar{display:none}.rc>*{scroll-snap-align:start}
  @media (max-width:560px){.rc{grid-auto-columns:46%}.rc-nav{display:none}}
  .mr{padding-top:clamp(20px,4vw,36px);padding-bottom:clamp(20px,4vw,36px)}
  .mr-h{font-size:clamp(20px,2.4vw,26px);font-weight:800;margin-bottom:16px}
  .mr-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
  .mr-c{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;height:96px;background:#fff;border:1px solid var(--line);border-radius:14px}.mr-c:hover{color:inherit;border-color:var(--y)}
  .mr-c b{font-size:22px;font-weight:900;letter-spacing:.02em}.mr-c small{font-size:12px;color:var(--mut)}
  .mr-dewalt{background:var(--y);border-color:var(--y)}.mr-dewalt b{background:var(--ink);color:var(--y);padding:2px 10px;transform:skewX(-8deg)}.mr-dewalt small{color:var(--ink)}
  .mr-stanley b{color:#111;border:2px solid #f5b800;padding:0 8px;border-radius:3px}
  .mr-blackdecker b{color:#111}.mr-blackdecker b::first-letter{color:#e8581c}
  .mr-usag b{color:#c8102e}.mr-lenox b{color:#003b7a}
  @media (max-width:560px){.mr-g{grid-template-columns:repeat(2,1fr)}.mr-c:first-child{grid-column:span 2}.mr-c b{font-size:19px}}
</style>
<script>
  // carosello "Prodotti consigliati"
  const rc = document.getElementById('rc');
  document.querySelectorAll<HTMLButtonElement>('[data-rc]').forEach((b) => b.addEventListener('click', () => rc?.scrollBy({ left: Number(b.dataset.rc) * rc.clientWidth * 0.9 })));
  // riquadro "Eccellente": voto della scheda Google (si mostra solo se disponibile)
  const box = document.querySelector<HTMLElement>('[data-voto]');
  if (box) fetch('/api/google').then((r) => r.json()).then((g) => {
    if (!g.ok || !g.voto || g.voto < 4.5) return;
    box.querySelector('[data-voto-v]')!.textContent = g.voto.toFixed(1).replace('.', ',');
    box.querySelector('[data-voto-n]')!.textContent = `${g.totale} recensioni su Google`;
    box.hidden = false;
  }).catch(() => {});
</script>
