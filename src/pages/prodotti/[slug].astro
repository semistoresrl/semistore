---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import prodotti from '../../data/prodotti.json';
import { fotoDi } from '../../data/foto';
import KitFoto from '../../components/KitFoto.astro';
import { SITO, euro } from '../../data/sito.js';
import { productLd } from '../../data/seo.js';
import { urlCategoria } from '../../data/catalogo';
import noleggio from '../../data/noleggio.json';
import { upsell } from '../../data/upsell';
export async function getStaticPaths() {
  return prodotti.map((prod) => ({ params: { slug: prod.slug }, props: { p: prod } }));
}
const { p } = Astro.props;
const img = fotoDi(p.slug);
const simili = prodotti.filter((x) => x.categoria === p.categoria && x.slug !== p.slug).slice(0, 4);
const titolo = `${p.marca} ${p.modello ? p.modello + ' ' : ''}${p.nome}`.replace(/\s+/g, ' ');
const specs = (p.caratteristiche || []).map((s) => { const i = s.indexOf(': '); return i > 0 && i < 40 ? [s.slice(0, i), s.slice(i + 2)] : ['', s]; });
const risparmio = p.prezzoListino && p.prezzoListino > p.prezzo ? Math.round((1 - p.prezzo / p.prezzoListino) * 100) : 0;
const ld = [productLd(p, img), { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: SITO.url + '/' },
  { '@type': 'ListItem', position: 2, name: p.categoria, item: SITO.url + urlCategoria(p.categoria) },
  { '@type': 'ListItem', position: 3, name: p.nome, item: `${SITO.url}/prodotti/${p.slug}/` } ] }];
const conferma = p.disponibilita === 'conferma';
// anche a noleggio (listino noleggio DEWALT): canone mensile IVA esclusa
const nol = (noleggio as any[]).find((x) => x.s === p.slug);
// Upselling: batterie per i solo corpo, proposta «completa l'acquisto», accessori compatibili (o macchine compatibili per gli accessori)
const up = upsell(p.slug);
const batterie = up && up.tipo === 'macchina' && up.soloCorpo ? up.batterie.slice(0, 4) : [];
const proposta = up && up.tipo === 'macchina' ? up.proposta.filter((x: any) => !batterie.some((b: any) => b.slug === x.slug)) : [];
const famBreve = (f: string) => f.replace(/ \(mandrino\)$/, '');
const LINGUE: Record<string, string> = { en: 'inglese', fr: 'francese', de: 'tedesco', es: 'spagnolo', pt: 'portoghese', nl: 'olandese', pl: 'polacco', cs: 'ceco', sk: 'slovacco', hu: 'ungherese', ro: 'rumeno', bg: 'bulgaro', el: 'greco', ru: 'russo', uk: 'ucraino', tr: 'turco', sv: 'svedese', th: 'thailandese', vi: 'vietnamita', id: 'indonesiano', ko: 'coreano' };
const vTit = p.video ? (p.video.it || p.video.t) : '';
const vLingua = p.video && p.video.l && p.video.l !== 'it' ? (LINGUE[p.video.l] || 'lingua straniera') : '';
---
<Base ogType="product" title={titolo} description={`${p.sottotitolo ? p.sottotitolo + '. ' : ''}${p.marca} ${p.modello || ''} a ${euro(p.prezzo)}: spedizione o ritiro a ${SITO.citta}, garanzia gestita da centro assistenza autorizzato.`} image={`/og/prodotti/${p.slug}.jpg`} prezzo={p.prezzo} jsonld={ld}>
  <div class="wrap">
    <nav aria-label="Percorso" class="bc"><a href="/">Home</a> / <a href="/catalogo/">Catalogo</a> / <a href={urlCategoria(p.categoria)}>{p.categoria}</a></nav>
    <div class="pd">
      <div class="card pd-img">
        {img ? <img src={img} width="800" height="800" alt={titolo} data-ph={p.modello || p.marca} fetchpriority="high" /> : p.kit ? <KitFoto pezzi={p.kit} alt={titolo} /> : <span class="mono" style="font-size:40px;color:#c9c6bc;font-weight:700">{p.modello || p.marca}</span>}
      </div>
      <div class="pd-i">
        <span class="row" style="gap:8px">{p.volt && <span class="pill k">{p.volt}</span>}<span class="pill">{p.marca}</span><span class="pill">{p.categoria}</span></span>
        <h1>{p.nome}</h1>
        {p.sottotitolo && <p class="pd-sub">{p.sottotitolo}</p>}
        {p.modello && <span class="mono" style="color:var(--mut)">Codice {p.modello}</span>}
        {p.kit && <p class="kit-in"><b>Nella confezione:</b> {p.kit.map((x) => (x.q && x.q > 1 ? x.q + ' × ' : '') + x.n).join(' · ')}</p>}
        <div class="pd-pr">{euro(p.prezzo)} <small>IVA inclusa</small></div>
        {risparmio > 0 && <p class="pd-lst">Prezzo consigliato dal produttore <s>{euro(p.prezzoListino)}</s> · {risparmio}% in meno del prezzo consigliato</p>}
        <div class="row" style="gap:10px">
          <label class="field qty"><span class="sr">Quantità</span><input id="qty" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
          <button class="btn btn-y" id="add" data-slug={p.slug} data-id={p.modello || p.slug} data-nome={p.nome} data-marca={p.marca} data-cat={p.categoria} data-prezzo={(p.prezzo / 100).toFixed(2)} style="flex:1">Aggiungi al carrello</button>
        </div>
        {nol && <a class="nol" href={`/noleggio/?add=${encodeURIComponent(nol.c)}`}><span><b>Anche a noleggio per aziende</b><small>{euro(Math.round(nol.k * 100))} al mese + IVA, manutenzione 3 anni inclusa</small></span><span class="nol-v">Noleggialo →</span></a>}
        <p id="ok" hidden class="okmsg" role="status">Aggiunto. <a class="ul" href="/carrello/">Vai al carrello</a></p>
        {batterie.length > 0 && (
          <div class="bat">
            <b>È un solo corpo: ti servono batterie e caricabatterie?</b>
            <span>Se non le hai già, ecco quelle compatibili {up && up.tipo === 'macchina' && up.al ? `(${up.al === '54V' ? '54V FLEXVOLT' : up.al})` : ''}:</span>
            {batterie.map((x: any) => (
              <div class="bat-r">
                {fotoDi(x.slug, 400) ? <img src={fotoDi(x.slug, 400)} alt="" width="56" height="56" loading="lazy" /> : <span></span>}
                <a href={`/prodotti/${x.slug}/`}><b>{x.nome}</b><small>{x.modello}{x.disponibilita === 'conferma' ? ' · su conferma' : ' · disponibile'}</small></a>
                <span class="up-p"><b>{euro(x.prezzo)}</b><button type="button" class="up-add" data-add={x.slug} aria-label={`Aggiungi ${x.nome} al carrello`}>+ Aggiungi</button></span>
              </div>
            ))}
          </div>
        )}
        {proposta.length > 0 && (
          <div class="bund" id="bund">
            <b>Completa l'acquisto</b>
            <span class="bund-s">Gli accessori compatibili più scelti con questo utensile:</span>
            <label class="bund-r bund-me"><input type="checkbox" checked disabled /><span><b>Questo articolo</b><small>{p.modello}</small></span><b>{euro(p.prezzo)}</b></label>
            {proposta.map((x: any) => (
              <label class="bund-r">
                <input type="checkbox" checked data-b={x.slug} data-pr={x.prezzo} />
                <span><a href={`/prodotti/${x.slug}/`}>{x.nome}</a><small>{x.modello}{x.disponibilita === 'conferma' ? ' · su conferma' : ''}</small></span>
                <b>{euro(x.prezzo)}</b>
              </label>
            ))}
            <button type="button" class="btn btn-k" id="bundGo" data-base={p.prezzo}>Aggiungi tutto al carrello · <span id="bundTot">{euro(p.prezzo + proposta.reduce((t: number, x: any) => t + x.prezzo, 0))}</span></button>
          </div>
        )}
        {up && up.tipo !== 'macchina' && up.macchine.length > 0 && (
          <a class="fit" href="#compatibili"><span><b>{up.tipo === 'batteria' ? 'Alimenta' : 'Va bene su'} {up.totale} {up.totale === 1 ? 'utensile' : 'utensili'}</b><small>{up.macchine.slice(0, 3).map((x: any) => x.modello).join(', ')}{up.totale > 3 ? '…' : ''}</small></span><span class="nol-v">Vedi quali →</span></a>
        )}
        <div class="sbar" id="sbar" aria-hidden="true">
          <span class="sbar-t"><b>{euro(p.prezzo)}</b><small>{p.modello || p.marca}</small></span>
          <button type="button" class="btn btn-y" id="add2" tabindex="-1">Aggiungi al carrello</button>
        </div>
        <ul class="pd-l">
          {conferma
            ? <li><b>Disponibilità su conferma:</b> dopo l'ordine ti contattiamo entro 1 giorno lavorativo per confermare disponibilità e tempi. Se il prodotto non è disponibile ti rimborsiamo subito l'intero importo.</li>
            : <li>Spedizione in {SITO.spedizione.giorni} giorni lavorativi, gratis sopra {euro(SITO.spedizione.gratisDa)}</li>}
          {conferma && <li>Spedizione gratis sopra {euro(SITO.spedizione.gratisDa)}, tempi indicati alla conferma</li>}
          <li>Ritiro gratuito in negozio a {SITO.citta}</li>
          <li>Garanzia e riparazioni gestite direttamente da noi, centro autorizzato</li>
          <li>Hai dubbi su batterie o kit? <a class="ul" href={`tel:${SITO.telefonoLink}`}>Chiamaci</a>{SITO.whatsapp && <> o <a class="ul" target="_blank" rel="noopener" href={`https://wa.me/${SITO.whatsapp}?text=${encodeURIComponent(`Ciao Semi, vorrei informazioni su ${p.marca} ${p.modello || ''} ${p.nome} (${SITO.url}/prodotti/${p.slug}/)`)}`}>scrivici su WhatsApp</a></>}</li>
        </ul>
      </div>
    </div>
    {(p.descrizione || specs.length > 0 || p.dotazione || p.punti) && (
      <section class="sec pd-det">
        {p.descrizione && <div class="pd-d"><h2 class="h2">Descrizione</h2>{p.descrizione.split('\n\n').map((t: string) => <p>{t}</p>)}</div>}
        {p.punti?.length > 0 && <div class="pd-d"><h2 class="h2">Punti di forza</h2><ul class="pd-v">{p.punti.map((t: string) => <li>{t}</li>)}</ul></div>}
        {p.impieghi?.length > 0 && <div class="pd-d"><h2 class="h2">Ideale per</h2><ul class="pd-tags">{p.impieghi.map((t: string) => <li>{t}</li>)}</ul></div>}
        {specs.length > 0 && <div class="pd-d"><h2 class="h2">Caratteristiche tecniche</h2>
          <table class="pd-t"><tbody>{specs.map(([k, v]) => <tr>{k ? <><th scope="row">{k}</th><td>{v}</td></> : <td colspan="2">{v}</td>}</tr>)}</tbody></table></div>}
        {p.dotazione && <div class="pd-d"><h2 class="h2">Nella confezione</h2><p>{p.dotazione.replace(/\.$/, '')}.</p></div>}
        {p.video && <div class="pd-d"><h2 class="h2">Video</h2>
          <div class="yt-w"><div class="yt-box">
            <button class="yt" data-id={p.video.id} data-sub={vLingua ? '1' : undefined} aria-label={`Guarda il video: ${vTit}`}>
              <img src={`/api/yt/${p.video.id}.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
              <span class="yt-p" aria-hidden="true"></span>
            </button>
          </div></div>
          <p class="yt-t"><b>{vTit}</b>{p.video.ch && <> · <span>{p.video.ch}</span></>}</p>
          {vLingua && <p class="yt-l">Video in {vLingua}: i sottotitoli partono da soli. Se non sono in italiano, tocca ⚙ → Sottotitoli → Traduzione automatica → Italiano.</p>}</div>}
        {p.consiglio && <div class="pd-d pd-tip"><h2 class="h2">Il consiglio del nostro tecnico</h2><p>{p.consiglio}</p></div>}
      </section>
    )}
    {up && up.tipo === 'macchina' && up.gruppi.length > 0 && (
      <section class="sec" id="compatibili">
        <div class="sec-h"><h2 class="h2">Accessori compatibili</h2></div>
        <p class="up-int">Lame, dischi, punte e accessori che vanno su questo utensile{up.al && up.al !== '230V' ? ` (piattaforma ${up.al})` : ''}. Hai dubbi? <a class="ul" href={`https://wa.me/${SITO.whatsapp}?text=${encodeURIComponent(`Ciao Semi, quali accessori mi consigliate per ${p.modello}?`)}`} target="_blank" rel="noopener">Chiedici su WhatsApp</a>.</p>
        <div class="up-tabs" role="tablist">{up.gruppi.map((g: any, i: number) => <button type="button" role="tab" class={i === 0 ? 'on' : ''} data-tab={i}>{famBreve(g.famiglia)} <small>{g.totale}</small></button>)}</div>
        {up.gruppi.map((g: any, i: number) => (
          <div class="up-g" data-pan={i} hidden={i !== 0}>
            {g.prodotti.map((x: any) => (
              <div class="up-r">
                <a href={`/prodotti/${x.slug}/`} class="up-i">{fotoDi(x.slug, 400) ? <img src={fotoDi(x.slug, 400)} alt="" width="64" height="64" loading="lazy" /> : <span class="mono">{x.modello}</span>}</a>
                <a href={`/prodotti/${x.slug}/`} class="up-n"><b>{x.nome}</b><small class="mono">{x.modello}{x.disponibilita === 'conferma' ? ' · su conferma' : ' · disponibile'}</small></a>
                <span class="up-p"><b>{euro(x.prezzo)}</b><button type="button" class="up-add" data-add={x.slug} aria-label={`Aggiungi ${x.nome} al carrello`}>+ Aggiungi</button></span>
              </div>
            ))}
            {g.totale > g.prodotti.length && <p class="up-more">Altri {g.totale - g.prodotti.length} compatibili: <a class="ul" href={`https://wa.me/${SITO.whatsapp}?text=${encodeURIComponent(`Ciao Semi, cerco ${famBreve(g.famiglia).toLowerCase()} per ${p.modello}`)}`} target="_blank" rel="noopener">chiedici quello giusto su WhatsApp</a>.</p>}
          </div>
        ))}
      </section>
    )}
    {up && up.tipo !== 'macchina' && up.macchine.length > 0 && (
      <section class="sec" id="compatibili">
        <div class="sec-h"><h2 class="h2">{up.tipo === 'batteria' ? 'Utensili compatibili' : 'Va bene su questi utensili'}</h2></div>
        <p class="up-int">{up.totale} {up.totale === 1 ? 'utensile compatibile' : 'utensili compatibili'} nel nostro catalogo{up.totale > up.macchine.length ? `, ecco i primi ${up.macchine.length}` : ''}.</p>
        <div class="grid-p">{up.macchine.map((x: any) => <ProductCard p={x} />)}</div>
      </section>
    )}
    {simili.length > 0 && <section class="sec"><div class="sec-h"><h2 class="h2">Simili</h2></div><div class="grid-p">{simili.map((s) => <ProductCard p={s} />)}</div></section>}
  </div>
</Base>
<script>
  let ytObs: IntersectionObserver | null = null;
  document.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const play = t.closest<HTMLButtonElement>('.yt'), close = t.closest('.yt-x');
    if (play) {
      const box = play.parentElement as HTMLElement, wrap = box.parentElement as HTMLElement;
      box.dataset.thumb = box.innerHTML;
      box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${play.dataset.id}?autoplay=1&rel=0&playsinline=1&modestbranding=1&hl=it${play.dataset.sub ? '&cc_load_policy=1&cc_lang_pref=it' : ''}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen title="Video prodotto"></iframe><button class="yt-x" aria-label="Chiudi video">×</button>`;
      box.classList.add('yt-on');
      ytObs?.disconnect();
      ytObs = new IntersectionObserver(([e]) => box.classList.toggle('yt-float', !e.isIntersecting && box.classList.contains('yt-on')), { threshold: 0.25 });
      ytObs.observe(wrap);
    } else if (close) {
      const box = close.parentElement as HTMLElement;
      ytObs?.disconnect(); box.classList.remove('yt-on', 'yt-float'); box.innerHTML = box.dataset.thumb || '';
    }
  });
  import { add } from '../../scripts/cart.js';
  import { track } from '../../scripts/track.js';
  const b = document.getElementById('add')!;
  const art = (qty = 1) => ({ items: [{ id: b.dataset.id, nome: b.dataset.nome, marca: b.dataset.marca, cat: b.dataset.cat, prezzo: Number(b.dataset.prezzo), qty }], value: Number(b.dataset.prezzo) * qty });
  track('view_item', art());
  b.addEventListener('click', () => {
    const q = Math.max(1, Math.min(20, Number((document.getElementById('qty') as HTMLInputElement).value) || 1));
    add(b.dataset.slug!, q); track('add_to_cart', art(q)); (document.getElementById('ok') as HTMLElement).hidden = false;
  });
  // upselling: pulsanti «+ Aggiungi», pacchetto «Completa l'acquisto», schede degli accessori
  const fatto = (btn: HTMLElement) => { btn.textContent = 'Aggiunto ✓'; btn.classList.add('ok'); (document.getElementById('ok') as HTMLElement).hidden = false; };
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((x) => x.addEventListener('click', () => { add(x.dataset.add!, 1); track('add_to_cart', { items: [{ id: x.dataset.add }], value: 0 }); fatto(x); }));
  const bg = document.getElementById('bundGo');
  if (bg) {
    const box = document.getElementById('bund')!, tot = document.getElementById('bundTot')!;
    const eur = (c: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(c / 100);
    const sel = () => [...box.querySelectorAll<HTMLInputElement>('[data-b]')].filter((i) => i.checked);
    box.addEventListener('change', () => { tot.textContent = eur(Number(bg.dataset.base) + sel().reduce((t, i) => t + Number(i.dataset.pr), 0)); });
    bg.addEventListener('click', () => { add(b.dataset.slug!, 1); track('add_to_cart', art(1)); sel().forEach((i) => add(i.dataset.b!, 1)); bg.textContent = 'Aggiunti ✓ · vai al carrello'; bg.onclick = () => (location.href = '/carrello/'); (document.getElementById('ok') as HTMLElement).hidden = false; });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => t.addEventListener('click', () => {
    document.querySelectorAll('[data-tab]').forEach((x) => x.classList.toggle('on', x === t));
    document.querySelectorAll<HTMLElement>('[data-pan]').forEach((p) => (p.hidden = p.dataset.pan !== t.dataset.tab));
  }));
  // barra "Aggiungi al carrello" fissa in basso su telefono, quando il pulsante principale non si vede più
  const sbar = document.getElementById('sbar')!;
  document.getElementById('add2')!.addEventListener('click', () => { add(b.dataset.slug!, 1); track('add_to_cart', art(1)); const t = document.getElementById('add2')!; t.textContent = 'Aggiunto ✓'; setTimeout(() => (location.href = '/carrello/'), 400); });
  let raf = 0;
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; const v = b.getBoundingClientRect().bottom < 0; sbar.classList.toggle('on', v); document.body.classList.toggle('sbar-on', v && innerWidth <= 760); }); }, { passive: true });
</script>
<style>
  .nol{display:flex;justify-content:space-between;align-items:center;gap:12px;border:2px solid var(--ink);border-radius:12px;padding:12px 14px;color:var(--ink)}.nol span{display:flex;flex-direction:column;gap:2px}.nol small{color:var(--mut);font-size:13.5px}.nol-v{font-weight:900;white-space:nowrap}.nol:hover{background:#fffbea;color:var(--ink)}
  .bat-r a{color:var(--ink)}.up-p{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
  .up-add{border:2px solid var(--ink);background:#fff;border-radius:999px;padding:4px 12px;font:inherit;font-size:13px;font-weight:800;cursor:pointer;white-space:nowrap}.up-add:hover{background:var(--y)}.up-add.ok{background:#e7f6ec;border-color:#1a8f3a;color:#1a6b2f}
  .bund{display:flex;flex-direction:column;gap:6px;border:2px solid var(--ink);border-radius:12px;padding:14px;font-size:14px}.bund-s{color:var(--mut);font-size:13.5px}
  .bund-r{display:grid;grid-template-columns:22px 1fr auto;gap:10px;align-items:center;padding:6px 0;border-top:1px solid var(--line);cursor:pointer}.bund-r input{width:18px;height:18px;accent-color:#111}
  .bund-r a{color:var(--ink);font-weight:600;font-size:13.5px;line-height:1.25}.bund-r small{display:block;color:var(--mut);font-size:12px}.bund-me span b{font-size:13.5px}
  .fit{display:flex;justify-content:space-between;align-items:center;gap:12px;border:2px solid var(--ink);border-radius:12px;padding:12px 14px;color:var(--ink)}.fit span{display:flex;flex-direction:column;gap:2px}.fit small{color:var(--mut);font-size:13.5px}.fit:hover{background:#fffbea;color:var(--ink)}
  .up-int{color:var(--mut);margin:-6px 0 14px}.up-tabs{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:10px;scrollbar-width:thin}
  .up-tabs button{border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:7px 14px;font:inherit;font-size:14px;font-weight:700;white-space:nowrap;cursor:pointer}.up-tabs button small{color:var(--mut);font-weight:600}.up-tabs button.on{background:var(--ink);color:#fff;border-color:var(--ink)}.up-tabs button.on small{color:#ddd}
  .up-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:10px}.up-g[hidden]{display:none}
  .up-r{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:12px;padding:8px 12px 8px 8px}
  .up-i{display:grid;place-items:center;width:64px;height:64px}.up-i img{width:64px;height:64px;object-fit:contain}.up-i .mono{font-size:10px;color:var(--mut)}
  .up-n{color:var(--ink)}.up-n b{display:block;font-size:14px;line-height:1.3;font-weight:600}.up-n small{color:var(--mut);font-size:12px}.up-more{grid-column:1/-1;color:var(--mut);font-size:14px;margin:4px 0 0}
  @media(max-width:600px){.up-g{grid-template-columns:1fr}}
  .bat{display:flex;flex-direction:column;gap:8px;background:#fff8dc;border:1px solid #f5b80066;border-radius:12px;padding:14px;font-size:14px}
  .bat-r{display:grid;grid-template-columns:56px 1fr auto;color:var(--ink);gap:10px;align-items:center;background:#fff;border-radius:10px;padding:6px 10px 6px 6px;border:1px solid var(--line)}.bat-r:hover{border-color:var(--y);color:var(--ink)}
